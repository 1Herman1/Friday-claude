generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUM'ы ──────────────────────────────────────────────────────────────────

enum UserRole {
  super_admin
  orders_manager
  products_manager
  customer
}

enum BonusLevel {
  newcomer
  active
  premium
}

enum OtpChannel {
  email
  sms
}

/// Сценарий, ради которого выпущен одноразовый код. Без него код входа и код
/// подтверждения нового адреса взаимозаменяемы: verifyOtp брал любой свежий
/// код пользователя, и письмо на неподтверждённый адрес открывало вход.
enum OtpPurpose {
  login
  delete
  email_change
}

enum PetSpecies {
  cat
  dog
  other
}

/// Вид животного, которому подходит ТОВАР. Намеренно отдельный тип от
/// PetSpecies: там питомец покупателя, и у живого кота не бывает состояний
/// «подходит обоим» и «вид не определён». Значение other в PetSpecies — это
/// «хомяк, попугай», а не «неизвестно», переиспользовать его нельзя.
///
/// both и unknown — разные вещи. both — осознанное «универсальный уход для
/// кошек и собак» (см. determineSpecies в services/quiz-autotag.ts, который
/// намеренно не угадывает вид у таких товаров). unknown — «ещё не размечено».
enum ProductSpecies {
  cat
  dog
  both
  unknown
}

/// Как вписывать логотип бренда в плитку на главной. Раньше — захардкоженная
/// карта LOGO_GROUPS в client/src/components/home/BrandsSection.tsx.
enum BrandLogoFit {
  wide
  mid
  mark
}

enum SyncStatus {
  running
  success
  failed
  aborted
}

enum FilterType {
  checkbox
  range
  select
}

enum OrderStatus {
  new
  confirmed
  in_transit
  delivered
  cancelled
}

enum DeliveryMethod {
  /// Свой курьер. Раньше значения не было, и витрина писала такие заказы как
  /// cdek — после запуска каждый заказ своим курьером выглядел бы заказом СДЭК.
  simba_courier
  cdek
  yandex
  /// post, ozon, dostavista покупателю не предлагаются (решение владельца),
  /// но значения остаются: код провайдеров в репозитории сохранён.
  post
  ozon
  dostavista
  pickup
}

enum PaymentMethod {
  card
  cash_on_delivery
}

/// Движение бонусов. Баланс пользователя — сумма этих строк, а не отдельная правда.
enum BonusTxType {
  welcome
  earned
  spent
  refund_used
  revoke_earned
  admin_adjust
  quiz
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum BlogStatus {
  draft
  published
}

enum BannerPage {
  home
  catalog
  about
  other
}

enum BannerPosition {
  main_slider
  promo_strip
  sidebar
}

enum ChatRole {
  user
  assistant
}

enum QuizSpecies {
  cat
  dog
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum ConsentKind {
  pd_processing
  review_publication
  withdrawal
}

/// Уровень категории в дереве «Вид → Тип → Назначение»
enum CategoryKind {
  species
  type
  purpose
}

enum PromoType {
  percent
  fixed
}

// ─── МОДЕЛИ ──────────────────────────────────────────────────────────────────

/// Пользователи системы — покупатели и сотрудники магазина
model User {
  id                  String     @id @default(uuid())
  email               String?    @unique
  phone               String?    @unique
  username            String?    @unique
  name                String
  passwordHash        String?
  role                UserRole   @default(customer)
  bonusPoints         Int        @default(0)
  bonusLevel          BonusLevel @default(newcomer)
  /// 300 бонусов выдаются один раз за всю жизнь аккаунта: при первом входе (welcome) либо по факту прохождения квиза (quiz) — что случится раньше.
  welcomeBonusGranted Boolean    @default(false)
  isActive            Boolean    @default(true)
  /// Последняя активность пользователя на сайте — для аналитики активности
  lastSeenAt          DateTime?
  /// Обезличен по запросу
  deletedAt           DateTime?
  /// Момент, начиная с которого выданные токены действительны: всё, что подписано раньше, отвергается. Смена почты, блокировка и обезличивание гасят ранее выданные JWT, не дожидаясь их срока.
  sessionsValidFrom   DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  addresses         Address[]
  pets              Pet[]
  orders            Order[]
  cart              Cart?
  subscriptions     Subscription[]
  otpCodes          OtpCode[]
  chatMessages      ChatMessage[]
  comparison        Comparison?
  favorites         Favorite[]
  bonusTransactions BonusTransaction[]
  quizSessions      QuizSession[]
  reviews           Review[]
  consents          Consent[]

  @@index([email])
  @@index([phone])
  @@index([username])
  @@index([role])
  @@index([lastSeenAt])
  @@index([deletedAt])
  @@map("users")
}

/// Одноразовые коды для входа по email или SMS — вместо паролей
model OtpCode {
  id        String     @id @default(uuid())
  userId    String
  code      String
  channel   OtpChannel
  /// Для какого сценария выпущен код — код одного сценария не подходит другому
  purpose   OtpPurpose @default(login)
  /// Адрес или номер, на который код реально ушёл. Пусто у кодов, выпущенных до
  /// появления поля: тогда адрес не проверяется, иначе живые коды сломались бы.
  target    String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  /// Порядок полей — под выборку verifyOtp: код ищется по владельцу, сценарию и хешу
  @@index([userId, purpose, code])
  @@map("otp_codes")
}

/// Адреса доставки пользователей
model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String
  city       String
  street     String
  house      String
  apartment  String?
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// Питомцы пользователей — для персонализации рекомендаций корма
model Pet {
  id          String     @id @default(uuid())
  userId      String
  name        String
  species     PetSpecies
  breed       String?
  birthDate   DateTime?
  healthNotes String?
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pets")
}

/// Категории каталога — поддерживают дерево (подкатегории через parentId)
model Category {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  description    String?
  image          String?
  parentId       String?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  /// Уровень в дереве «Вид → Тип → Назначение»
  kind           CategoryKind?
  /// Вид животного для узлов-видов и их потомков
  species        ProductSpecies?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]
  filters  CategoryFilter[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
  @@index([kind])
  @@map("categories")
}

/// Бренды производителей — Royal Canin, Hill's и другие
model Brand {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  logo        String?
  /// Фирменный цвет бренда в hex (#0F70B5 у Farmina) — заливка плитки на главной.
  /// В БД, а не в компоненте: hex вне палитры проекта ловит design-lint.mjs.
  /// Формат держит CHECK brands_accentColor_format_check из миграции
  /// species_and_brand_identity — в schema.prisma он невыразим.
  accentColor String?
  /// null означает mid — то же поведение по умолчанию, что и на клиенте сейчас.
  logoFit     BrandLogoFit?
  description String?
  createdAt   DateTime      @default(now())

  products Product[]

  @@index([slug])
  @@map("brands")
}

/// Товары каталога. isActive = false скрывает товар без удаления из БД
model Product {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  description      String
  brandId          String?
  images           String[]
  isGrainFree      Boolean        @default(false)
  isHypoallergenic Boolean        @default(false)
  isWeightControl  Boolean        @default(false)
  protein          Float?
  fat              Float?
  fiber            Float?
  ash              Float?
  ingredients      String?
  seoTitle         String?
  seoDescription   String?
  isActive         Boolean        @default(true)
  /// Скрыт вручную из админки. Синхронизация МойСклад НЕ возвращает isActive=true таким товарам.
  hiddenManually   Boolean        @default(false)
  /// Какие вкладки показывать на странице товара
  showAboutTab     Boolean        @default(true)
  showSpecsTab     Boolean        @default(true)
  showReviewsTab   Boolean        @default(true)
  /// Вид животного, которому подходит товар. По умолчанию unknown, чтобы
  /// неразмеченный товар не получил ложный вид. Дублирует тег species:* в
  /// quizTags намеренно: тег обслуживает подбор, поле — фильтр каталога.
  species          ProductSpecies @default(unknown)
  /// Теги для квиза-подборщика. Закрытый словарь — server/src/lib/quiz-tags.ts. Пустой массив = товар в подборе не участвует.
  quizTags         String[]       @default([])
  /// Теги, выведенные автоматически из фильтров/категорий/названия (backfill-quiz-tags.ts).
  /// Ручные quizTags приоритетнее: при совпадении пространства имён выигрывают они.
  autoQuizTags     String[]       @default([])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  brand         Brand?               @relation(fields: [brandId], references: [id])
  categories    ProductCategory[]
  variants      ProductVariant[]
  filterValues  ProductFilterValue[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  comparisons   ComparisonProduct[]
  subscriptions Subscription[]
  favorites     Favorite[]
  reviews       Review[]
  isFeatured    Boolean              @default(false)

  @@index([slug])
  @@index([brandId])
  @@index([isActive])
  /// Запрос каталога — «товары этого вида, которые в продаже». Левый префикс
  /// обслуживает и фильтр по одному species, отдельный индекс не нужен.
  @@index([species, isActive])
  @@index([quizTags], type: Gin)
  @@index([autoQuizTags], type: Gin)
  @@map("products")
}

/// Варианты товара — разные фасовки с разными ценами и остатками
/// Цены в копейках: 199900 = 1999 рублей
model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  weight     Float
  price      Int
  oldPrice   Int?
  stock      Int      @default(0)
  sku        String?  @unique
  moyskladId String?  @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  subscriptions Subscription[]

  @@index([productId])
  @@index([isActive])
  @@map("product_variants")
}

/// Фильтры каталога: "Вид животного", "Проблема здоровья", "Вес упаковки"
model Filter {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  type      FilterType
  createdAt DateTime   @default(now())

  values     FilterValue[]
  categories CategoryFilter[]

  @@index([slug])
  @@map("filters")
}

/// Значения фильтров: "Кошки", "Почечная недостаточность", "2 кг"
model FilterValue {
  id        String   @id @default(uuid())
  filterId  String
  value     String
  slug      String
  createdAt DateTime @default(now())

  filter   Filter               @relation(fields: [filterId], references: [id], onDelete: Cascade)
  products ProductFilterValue[]

  @@unique([filterId, slug])
  @@index([filterId])
  @@map("filter_values")
}

// ─── ТАБЛИЦЫ СВЯЗЕЙ (many-to-many) ───────────────────────────────────────────

/// Товар ↔ Категория
model ProductCategory {
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

/// Товар ↔ Значение фильтра (для фильтрации в каталоге)
model ProductFilterValue {
  productId     String
  filterValueId String

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  filterValue FilterValue @relation(fields: [filterValueId], references: [id], onDelete: Cascade)

  @@id([productId, filterValueId])
  @@index([filterValueId])
  @@map("product_filter_values")
}

/// Категория ↔ Фильтр (какие фильтры показывать в каждой категории)
model CategoryFilter {
  categoryId String
  filterId   String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  filter   Filter   @relation(fields: [filterId], references: [id], onDelete: Cascade)

  @@id([categoryId, filterId])
  @@map("category_filters")
}

// ─── КОРЗИНА ─────────────────────────────────────────────────────────────────

/// Корзина пользователя — одна на пользователя (One-to-One)
model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

/// Позиция в корзине — конкретный вариант товара и количество
model CartItem {
  id                       String   @id @default(uuid())
  cartId                   String
  productVariantId         String
  productId                String
  quantity                 Int
  isSubscription           Boolean  @default(false)
  subscriptionIntervalDays Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])

  @@unique([cartId, productVariantId, isSubscription])
  @@index([cartId])
  @@map("cart_items")
}

// ─── ЗАКАЗЫ ──────────────────────────────────────────────────────────────────

/// Заказы — фиксируют сумму, адрес и способ доставки на момент оформления
model Order {
  id                  String         @id @default(uuid())
  userId              String
  status              OrderStatus    @default(new)
  deliveryMethod      DeliveryMethod
  deliveryAddress     Json?
  /// Пункт выдачи (PickupPoint из @simba/shared) целиком, а не ссылкой:
  /// если пункт закроется, в заказе должно остаться, куда везли. Есть пункт —
  /// заказ в ПВЗ, нет — до двери или самовывоз по deliveryMethod.
  deliveryPoint       Json?
  deliveryCost        Int            @default(0)
  /// Сколько доставка этого заказа стоит магазину (копейки) — по тарифу службы
  /// на момент заказа. Не путать с deliveryCost: то платит покупатель.
  /// Пусто — посчитать не удалось, причина в deliveryExpenseNote.
  deliveryExpense     Int?
  deliveryExpenseNote String?
  subtotal            Int
  total               Int
  bonusUsed           Int            @default(0)
  bonusEarned         Int            @default(0)
  bonusEarnedCredited Boolean        @default(false)
  bonusUsedRefunded   Boolean        @default(false)
  hasSpecialPackaging Boolean        @default(false)
  paymentStatus       PaymentStatus  @default(pending)
  paymentMethod       PaymentMethod  @default(card)
  paymentId           String?
  /// Остаток вернули на склад при отмене — защёлка от повторного возврата
  stockRestored       Boolean        @default(false)
  /// id документа возврата в МойСклад, если его удалось создать
  msReturnId          String?
  comment             String?
  /// Снапшот контактов на момент оформления — для гостевых заказов и на случай смены данных в профиле
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  /// Заказ оформлен без входа (JWT type=guest). Для дашборда: «гости» vs «пользователи».
  guestCheckout       Boolean        @default(false)
  /// Снапшот кода на момент заказа — остаётся, даже если промокод удалили
  promoCode           String?
  promoCodeId         String?
  /// Скидка по промокоду, копейки
  discount            Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  items             OrderItem[]
  bonusTransactions BonusTransaction[]
  promo             PromoCode?         @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  consents          Consent[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([promoCodeId])
  @@index([guestCheckout])
  @@map("orders")
}

/// Журнал движений бонусов. Раньше в базе было только текущее число на
/// пользователе: разобрать жалобу «куда делись мои scoins» было нечем.
model BonusTransaction {
  id           String      @id @default(uuid())
  userId       String
  orderId      String?
  type         BonusTxType
  /// Со знаком: плюс — начисление, минус — списание
  amount       Int
  /// Баланс после операции — чтобы историю можно было читать без пересчёта
  balanceAfter Int
  comment      String?
  createdAt    DateTime    @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([orderId])
  @@map("bonus_transactions")
}

/// Позиция заказа — снапшот данных товара на момент покупки
/// productName и price фиксируются навсегда, чтобы история не менялась при изменении товара
model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  productVariantId String
  productId        String
  productName      String
  variantWeight    Float
  price            Int
  quantity         Int
  isSubscription   Boolean  @default(false)
  subscriptionId   String?
  createdAt        DateTime @default(now())

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─── ПОДПИСКИ ────────────────────────────────────────────────────────────────

/// Автоматические заказы — пользователь получает корм каждые N дней
model Subscription {
  id               String          @id @default(uuid())
  userId           String
  productVariantId String
  productId        String
  intervalDays     Int
  nextDeliveryAt   DateTime
  paymentMethodId  String?
  deliveryMethod   DeliveryMethod?
  deliveryAddress  Json?
  deliveryPoint    Json?
  isPaused         Boolean         @default(false)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])

  // Уникальность userId+productVariantId только среди активных подписок — частичный
  // индекс (не выразим в @@unique, Prisma не поддерживает WHERE), создан вручную в
  // миграции 20260819075814_subscription_stage1. Иначе отмена (isActive: false) не
  // освобождала бы вариант для повторной подписки.
  @@index([userId, isActive, createdAt(sort: Desc)])
  @@index([nextDeliveryAt])
  @@map("subscriptions")
}

// ─── СРАВНЕНИЕ ───────────────────────────────────────────────────────────────

/// Список сравнения товаров — один на пользователя
model Comparison {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products ComparisonProduct[]

  @@map("comparisons")
}

/// Товары в списке сравнения
model ComparisonProduct {
  comparisonId String
  productId    String
  addedAt      DateTime @default(now())

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([comparisonId, productId])
  @@map("comparison_products")
}

// ─── ИЗБРАННОЕ ───────────────────────────────────────────────────────────────

/// Избранные товары пользователя
model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("favorites")
}

// ─── КВИЗ ────────────────────────────────────────────────────────────────────

/// Одно прохождение квиза. userId = null у гостя: результат выдаётся сразу, без сбора контакта. Привязка к пользователю происходит позже, при claim после авторизации.
model QuizSession {
  id               String      @id @default(uuid())
  userId           String?
  species          QuizSpecies
  /// Сырые ответы как их прислал фронт. Нужны, чтобы экран результата отзеркалил ответы и чтобы разбирать жалобы «подобрало не то» без реконструкции по тегам.
  answers          Json
  /// Плоский нормализованный набор тегов, по которому реально шёл скоринг
  tags             String[]
  /// Результат по порядку: [0] — главная рекомендация, [1] — пара для mixed или первая альтернатива, дальше альтернативы
  resultProductIds String[]
  /// Какие жёсткие фильтры пришлось ослабить: ["brand","size"]. Пусто = точное совпадение
  relaxed          String[]    @default([])
  /// true, если именно эта сессия привела к начислению 300 бонусов
  bonusGranted     Boolean     @default(false)
  createdAt        DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("quiz_sessions")
}

// ─── БАННЕРЫ ─────────────────────────────────────────────────────────────────

/// Рекламные баннеры — управляются из админки
model Banner {
  id          String         @id @default(uuid())
  title       String
  subtitle    String?
  /// Картинка для компьютера. Широкая — слайд на десктопе низкий и длинный.
  image       String
  /// Отдельная картинка для телефона. Тот же файл там либо обрезается по бокам,
  /// либо становится нечитаемо мелким, поэтому формат второй, а не тот же.
  /// Пусто — показываем десктопную.
  imageMobile String?
  /// Готовый баннер с уже нарисованным текстом (как в Тильде) поверх себя ничего
  /// не терпит. Флаг решает, накладывать ли заголовок, подпись и кнопку.
  showText    Boolean        @default(true)
  link        String?
  buttonText  String?
  page        BannerPage
  position    BannerPosition
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([page, position])
  @@index([isActive])
  @@map("banners")
}

// ─── ЧАТ С AI ────────────────────────────────────────────────────────────────

/// История сообщений с AI-ассистентом магазина
/// sessionId — для анонимных пользователей до авторизации
model ChatMessage {
  id        String   @id @default(uuid())
  userId    String?
  sessionId String
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

/// История прогонов синхронизации с МойСклад.
/// Запись со статусом running служит защитой от параллельного запуска.
model SyncRun {
  id                String     @id @default(uuid())
  source            String     @default("moysklad")
  trigger           String
  status            SyncStatus @default(running)
  dryRun            Boolean    @default(false)
  startedAt         DateTime   @default(now())
  finishedAt        DateTime?
  itemsFromMs       Int        @default(0)
  matched           Int        @default(0)
  priceUpdated      Int        @default(0)
  stockUpdated      Int        @default(0)
  productsActivated Int        @default(0)
  missingInMs       Int        @default(0)
  skipped           Int        @default(0)
  error             String?
  report            Json?

  @@index([startedAt])
  @@index([status])
    /// Один идущий прогон на источник гарантирует частичный уникальный индекс
  /// sync_runs_source_running_key (миграция 20260918000001): Prisma такое
  /// декларативно не выражает, поэтому он живёт только в SQL миграции.
@@map("sync_runs")
}

/// Прайс-лист доставки. Цены фиксированные и меняются из админки — это
/// единственный источник и для чекаута, и для страницы «Доставка»: раньше текст
/// страницы и расчёт сервера жили порознь и разошлись.
model DeliveryOption {
  /// Ключ варианта из shared DeliveryOptionKey: simba_courier, cdek_pvz, …
  key       String   @id
  title     String
  subtitle  String?
  /// В копейках, как все цены проекта.
  price     Int      @default(0)
  /// Расход магазина на этот способ, копейки. Для служб с API не нужен —
  /// расход по заказу считается у службы; для своего курьера и самовывоза
  /// это единственный источник цифры.
  expense   Int      @default(0)
  /// Минимальное время доставки в днях (включительно)
  etaMin    Int?
  /// Максимальное время доставки в днях (включительно)
  etaMax    Int?
  /// Минимальная сумма заказа в копейках, с которой доставка становится бесплатной (null = не бесплатная)
  freeFrom  Int?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("delivery_options")
}

// ─── СМС-ТЕКСТЫ И ПОСТОЯННЫЕ СТРОКИ ──────────────────────────────────────────

/// Управляемые из админки текстовые строки сайта — заголовки, описания, СМС
model SiteText {
  /// Ключ строки, например: "home.brands.title", "email.welcome.subject"
  key       String   @id
  /// Текстовое значение (может содержать переменные типа {{name}})
  value     String
  /// Группа ключей для фильтрации в админке, например: "home", "email", "footer"
  group     String
  /// Человеческое описание для админки, чтобы понять что это за текст
  label     String
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("site_texts")
}

// ─── БЛОГ ─────────────────────────────────────────────────────────────────────

/// Записи блога — статьи с поддержкой категорий и SEO
model BlogPost {
  id              String     @id @default(uuid())
  /// URL-friendly идентификатор статьи
  slug            String     @unique
  title           String
  /// Краткое описание — используется в списке статей и в meta description
  subtitle        String?
  /// Тело статьи в формате markdown
  body            String     @default("")
  /// Категории статьи (строки, массив)
  categories      String[]   @default([])
  /// Дата публикации статьи
  date            DateTime
  /// Примерное время чтения в минутах (рассчитывается на клиенте либо задаётся вручную)
  readingMinutes  Int        @default(0)
  /// Статус публикации: draft или published
  status          BlogStatus @default(draft)
  /// Обложка статьи (путь или URL)
  cover           String?
  /// Заголовок для SEO (если пусто, используется title)
  metaTitle       String?
  /// Описание для SEO (если пусто, используется subtitle)
  metaDescription String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([date(sort: Desc)])
  @@map("blog_posts")
}

// ─── ОТЗЫВЫ И ПРОМОКОДЫ ──────────────────────────────────────────────────────

model Review {
  id         String       @id @default(uuid())
  authorName String
  /// 1..5, CHECK в миграции
  rating     Int
  text       String
  /// /api/media/<key> из saveFile
  photo      String?
  status     ReviewStatus @default(pending)
  userId     String?
  /// Задел на отзывы к конкретному товару; в показе сейчас не используется
  productId  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  product    Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  consents   Consent[]

  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
  @@index([productId])
  @@map("reviews")
}

model PromoCode {
  id           String    @id @default(uuid())
  /// Хранится в верхнем регистре
  code         String    @unique
  type         PromoType
  /// percent: 1..100; fixed: копейки
  value        Int
  minSubtotal  Int?
  startsAt     DateTime?
  endsAt       DateTime?
  maxUses      Int?
  usedCount    Int       @default(0)
  perUserLimit Int?
  isActive     Boolean   @default(true)
  comment      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]

  @@index([isActive])
  @@map("promo_codes")
}

// ─── СОГЛАСИЯ ────────────────────────────────────────────────────────────────

/// Записи о согласии пользователя на обработку персональных данных
model Consent {
  id        String       @id @default(uuid())
  userId    String?
  orderId   String?
  reviewId  String?
  kind      ConsentKind
  textVersion String      @db.VarChar(64)
  ip        String?     @db.VarChar(45)
  userAgent String?     @db.VarChar(512)
  createdAt DateTime     @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  review Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([userId, kind, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([reviewId])
  @@map("consents")
}

// ─── АНАЛИТИКА ───────────────────────────────────────────────────────────────

/// Ежедневный счётчик уникальных посещений сайта
model SiteVisit {
  /// День в UTC (только дата, без времени)
  day   DateTime @id @db.Date
  /// Количество уникальных посещений в этот день
  count Int      @default(0)

  @@map("site_visits")
}
