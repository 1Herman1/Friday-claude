# Шаблон боевого server/.env для VPS. Скопировать в server/.env и заполнить.
# НЕ коммитить реальные значения. JWT_SECRET и пароль БД — сгенерировать (см. DEPLOY.md).

# Перец для хеширования одноразовых кодов. Если пусто — берётся JWT_SECRET;
# отдельное значение предпочтительнее: тогда утечка одного секрета не открывает второй.
OTP_PEPPER=

# База (Postgres в Docker, пароль — НЕ дефолтный simba_dev!)
DATABASE_URL="postgresql://simba:ЗАМЕНИ_ПАРОЛЬ@localhost:5432/simba"

# JWT (сгенерировать: openssl rand -hex 32)
JWT_SECRET="ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_HEX_32"
JWT_EXPIRES_IN="7d"

# Администратор панели (логин+пароль). Пароль — НЕ простой, минимум 12 символов.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# MinIO (пароль — НЕ дефолтный).
# MINIO_SECRET_KEY обязан совпадать с MINIO_PASSWORD, которым поднимался
# docker compose: это один и тот же пароль с двух сторон. Разойдутся —
# загрузка картинок отвалится молча, с «The request signature we calculated
# does not match» в логе сервера. Сверка — в DEPLOY.md, раздел 4.
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="simba"
MINIO_SECRET_KEY="ЗАМЕНИ_ПАРОЛЬ"
MINIO_BUCKET="simba-products"

# OTP по email (без этого вход не работает). Данные ящика для noreply@.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@simbazoo.ru"

# OTP по SMS (опционально, альтернатива email)
SMS_API_KEY=""
SMS_SENDER=""

# URL фронтов (для CORS). На IP — http, после домена сменить на https://simbazoo.ru
CLIENT_URL="http://147.45.157.11"
ADMIN_URL="http://147.45.157.11/admin"

# Доставка — не подключённые службы не появятся в вариантах доставки. Оставить пустыми на старте.

# Склад, откуда уезжают заказы. От этих координат считают цену все службы;
# раньше здесь был зашит центр Москвы, и цены выходили «от Кремля».
WAREHOUSE_ADDRESS="Москва, ул. Ленина, 12"
WAREHOUSE_LAT="55.755864"
WAREHOUSE_LON="37.617617"

# Подсказки адреса на оформлении заказа — DaData (https://dadata.ru → API-ключи).
# До 10 000 подсказок в сутки бесплатно. Ключ только на сервере: витрина ходит
# через наш /api/address/suggest. Без ключа поля адреса остаются обычными.
DADATA_TOKEN=""

# СДЭК (https://www.cdek.ru/). Ключ и секрет — личный кабинет интегратора.
CDEK_CLIENT_ID=""
CDEK_CLIENT_SECRET=""
# CDEK_SANDBOX="true" — переключить на тестовый контур (https://api.edu.cdek.ru/v2)
CDEK_SANDBOX="false"
# Код города склада в справочнике СДЭК (Москва = 44). От него считаются тарифы.
CDEK_SENDER_CITY_CODE="44"

# Яндекс Доставка (https://yandex.ru/dev/delivery/). Токен — в личном кабинете продавца.
YANDEX_DELIVERY_TOKEN=""
# Пункты выдачи Яндекса считаются от склада: это platform_station_id склада
# из кабинета Яндекс.Доставки (раздел «Склады»). Без него ПВЗ Яндекса не
# предлагаются — цена до пункта считается именно от станции отправления.
YANDEX_PVZ_SOURCE_STATION=""


# Достависта (https://dostavista.ru/). Токен — в личном кабинете.
DOSTAVISTA_TOKEN=""
# DOSTAVISTA_SANDBOX="true" — переключить на тестовый контур (https://apitest.dostavista.ru/api/business/1.3)
DOSTAVISTA_SANDBOX="false"

# Почта России (https://otpravka.pochta.ru/). Токен и ключ — в личном кабинете отправителя.
POST_RU_TOKEN=""
POST_RU_USER_KEY=""

# Ozon (https://seller.ozon.ru/). Client ID и API Key — в личном кабинете продавца.
OZON_CLIENT_ID=""
OZON_API_KEY=""

# МойСклад (https://www.moysklad.ru/). Токен — в личном кабинете.
# ЭТАП 1: разведка, чтение данных. Токен должен иметь права на чтение assortment и stock.
MOYSKLAD_TOKEN=""
# Название типа цены в аккаунте (например "Цена продажи", "Основная цена" и т.д.)
# Определяется после первого запуска скрипта moysklad-report.ts.
MOYSKLAD_PRICE_TYPE="Цена (Сайт)"
# ЭТАП 2-3: синхронизация цен и остатков
# Минимальное количество позиций от МойСклада для безопасности (по умолчанию 300)
MOYSKLAD_MIN_ITEMS="300"
# Максимальный процент изменения цен для сигнализации об аномалии (по умолчанию 30%)
MOYSKLAD_MAX_CHANGE_PERCENT="30"
# Максимальный процент падения цены (по умолчанию 50%)
MOYSKLAD_MAX_PRICE_DROP_PERCENT="50"
# ЭТАП 4: запись документов (возвраты товара)
# Включить запись документов возврата в МойСклад (по умолчанию отключено)
MOYSKLAD_WRITE_ENABLED="false"
# ID склада в МойСкладе для документов приёмки (найти в Settings → Warehouses)
MOYSKLAD_WAREHOUSE_ID=""
# ID организации в МойСкладе (найти в Settings → Organizations)
MOYSKLAD_ORGANIZATION_ID=""
