---
import Button from '../ui/Button.astro';
---

<section class="min-h-screen bg-dark text-on-dark flex items-center justify-center py-16">
  <div class="max-w-6xl mx-auto px-5 md:px-8 w-full flex flex-col items-center text-center">
    <!-- Hero video with floating chips -->
    <div class="relative mb-12 max-w-sm w-full">
      <!-- Video -->
      <video
        id="hero-video"
        muted
        loop
        playsinline
        preload="metadata"
        poster="/media/hero/germes.jpg"
        aria-hidden="true"
        class="w-full h-auto rounded-2xl object-cover"
        style="max-height: 520px; aspect-ratio: 1;"
      >
        <source src="/media/hero/germes.mp4" type="video/mp4" />
      </video>

      <!-- Floating chips -->
      <div class="absolute top-8 right-0 md:top-12 md:right-8 z-10">
        <div class="px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm text-on-dark text-xs md:text-sm font-medium whitespace-nowrap">
          Сайты и сервисы
        </div>
      </div>

      <div class="absolute left-0 top-1/2 md:left-8 md:top-1/3 z-10 -translate-y-1/2">
        <div class="px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm text-on-dark text-xs md:text-sm font-medium whitespace-nowrap">
          SaaS
        </div>
      </div>

      <div class="absolute bottom-8 right-0 md:bottom-12 md:right-8 z-10">
        <div class="px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm text-on-dark text-xs md:text-sm font-medium whitespace-nowrap">
          ИИ-решения
        </div>
      </div>
    </div>

    <!-- Facts line -->
    <div class="text-on-dark/70 text-sm mb-6">
      8+ лет · 40+ проектов · Москва
    </div>

    <!-- Name heading -->
    <h1 class="text-[clamp(2.5rem,9vw,6.5rem)] font-bold font-heading leading-none mb-2">
      <span class="block text-on-dark">ГЕРМАН БРЫЗГАЛОВ</span>
      <span class="block text-accent">РАЗРАБОТКА И ВНЕДРЕНИЕ ИИ</span>
    </h1>

    <!-- Contact button -->
    <div class="mt-12 mb-6">
      <button
        id="hero-contact-btn"
        class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-on-dark text-foreground flex items-center justify-center hover:scale-105 transition-transform duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-dark"
        aria-label="Связаться"
      >
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>

    <!-- Call to action text -->
    <p class="text-on-dark/70 text-sm max-w-sm">
      Нажмите на кнопку, чтобы связаться со мной
    </p>
  </div>
</section>

<script>
  // Check prefers-reduced-motion before autoplaying
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement;

  if (!prefersReducedMotion) {
    // Hero video autoplays immediately since it's visible from the start
    heroVideo?.play().catch(() => {
      // Gracefully handle play() rejection (browser autoplay policies)
    });
  }

  // Contact button opens dialog
  const heroBtn = document.getElementById('hero-contact-btn');
  heroBtn?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open-contact-dialog'));
  });
</script>
