---
import Button from '../ui/Button.astro';

const BASE_URL = import.meta.env.BASE_URL;

// Chips from the approved canvas (390px artboard). Mobile: x/y — top-left corner inside the portrait (338×421.68),
// side — screen edge the chip sticks to, w — chip width (12px Roboto Mono). Desktop: dl/dt — offsets around the face center.
const PORTRAIT_W = 338;
const PORTRAIT_H = 421.68;
const chips = [
  { label: 'UI/UX-дизайн',           side: 'r', x: 238, y: 3,   w: 120.4, dl: 'calc(50% - 273px)', dt: '2%' },
  { label: 'Веб-порталы',            side: 'l', x: -23, y: 40,  w: 113.2, dl: 'calc(50% + 113px)', dt: '11%' },
  { label: 'Сайты',                  side: 'r', x: 282, y: 102, w: 70,    dl: 'calc(50% - 242px)', dt: '28%' },
  { label: 'SaaS',                   side: 'l', x: 2,   y: 173, w: 62.8,  dl: 'calc(50% + 141px)', dt: '39%' },
  { label: 'ИИ-решения',             side: 'r', x: 252, y: 231, w: 106,   dl: 'calc(50% - 258px)', dt: '54%' },
  { label: 'Разработка CRM',         side: 'l', x: -19, y: 273, w: 134.8, dl: 'calc(50% + 73px)',  dt: '66%' },
  { label: 'SEO и органик продюсер', side: 'r', x: 165, y: 320, w: 192.4, dl: 'calc(50% - 247px)', dt: '80%' },
].map(({ x, y, w, side, ...chip }) => ({
  ...chip,
  side,
  fh: side === 'l' ? x / PORTRAIT_W : (PORTRAIT_W - x - w) / PORTRAIT_W,
  fy: y / PORTRAIT_H,
}));
const crmFy = chips.find((chip) => chip.label === 'Разработка CRM')?.fy ?? 0;
---

<section class="hero-section relative min-h-[100svh] bg-[#010101] text-white overflow-hidden flex flex-col items-center justify-center">
  <!-- Top line: Sun icon + Name on the left, Telegram link on the right (absolute OVER the video zone) -->
  <div class="absolute top-10 left-0 right-0 z-50 flex items-center justify-between px-4 md:px-6">
    <!-- Left: Sun icon + Герман Брызгалов -->
    <div class="flex items-center gap-2 md:gap-2">
      <!-- Rune icon: glowing stone loop; mask on the video, glow on the wrapper (round halo) -->
      <span class="rune-glow flex-shrink-0" aria-hidden="true">
        <video
          id="rune-icon"
          muted
          loop
          autoplay
          playsinline
          preload="auto"
          poster={`${BASE_URL}media/hero/rune-poster.jpg`}
          style="width: 34px; height: 34px; object-fit: cover; display: block;"
        >
          <source src={`${BASE_URL}media/hero/rune.mp4`} type="video/mp4" />
        </video>
      </span>
      <!-- Name: Герман Брызгалов, mono 500 -->
      <span class="font-mono font-medium text-white" style="font-size: clamp(12px, 1.17vw, 16.8px); line-height: 1.2;">
        H&B team
      </span>
    </div>

    <!-- Right: location label (per canvas edit) -->
    <span
      class="font-mono font-medium text-white inline-flex items-center justify-center min-h-[44px] flex-shrink-0"
      style="font-size: clamp(12px, 1.17vw, 16.8px); line-height: 1.2;"
    >
      Москва
    </span>
  </div>

  <!-- Main content container: flex column to control vertical rhythm -->
  <div class="hero-stack relative w-full flex flex-col items-center justify-center" style="flex: 1; gap: 0;">
    <!-- Video zone container: max-w-[1200px], positioning anchor for chips -->
    <div class="hero-video-zone relative">
      <!-- Video container - centered -->
      <div class="hero-video-box">
        <video
          id="hero-video"
          muted
          loop
          playsinline
          preload="auto"
          poster={`${BASE_URL}media/hero/germes.webp`}
          fetchpriority="high"
          aria-hidden="true"
          class="w-full h-full object-cover"
        >
          <source src={`${BASE_URL}media/hero/germes-mobile.mp4`} type="video/mp4" media="(max-width: 767px)" />
          <source src={`${BASE_URL}media/hero/germes.mp4`} type="video/mp4" />
        </video>
      </div>

      <!-- Floating chips: positions from the approved canvas (mobile) / scaled around face center (desktop) -->
      {chips.map(({ label, side, fh, fy, dl, dt }) => (
        <div class={`hero-chip hero-chip--${side} absolute`} style={`--fh: ${fh}; --fy: ${fy}; --dl: ${dl}; --dt: ${dt}; --fg: ${crmFy};`} aria-hidden="true">
          <div class="hero-chip__pill px-4 rounded-full" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.65); backdrop-filter: blur(12px); font-family: var(--font-mono); font-weight: 400; color: white; display: inline-flex; align-items: center; white-space: nowrap; line-height: 1.2;">
            {label}
          </div>
        </div>
      ))}
    </div>

    <!-- Facts line (overlaps video slightly) -->
    <div
      class="hero-facts font-mono font-medium text-white text-center flex items-center justify-center relative"
      style="
        font-size: clamp(14px, 1.5vw, 21.6px);
        line-height: 1.2;
        gap: clamp(16px, 1.67vw, 30px);
      "
    >
      <span>От идеи до запуска</span>
    </div>

    <!-- H1 Heading (tight margin after facts) -->
    <h1
      class="hero-h1 font-heading uppercase text-center"
      style="
        text-wrap: balance;
        line-height: 1.0;
        letter-spacing: 0;
        max-width: 1200px;
        width: 100%;
      "
    >
      <span class="block" style="color: #F5F5F5;">ГЕРМАН БРЫЗГАЛОВ</span>
      <span class="block" style="color: #F97316; font-size: 0.67em;">IT-РАЗРАБОТКА И AI</span>
    </h1>

    <!-- What & for whom -->
    <p
      class="hero-sub text-center"
      style="
        font-family: var(--font-mono);
        font-size: clamp(13px, 1.15vw, 16.5px);
        line-height: 1.6;
        color: #C4C9D0;
        max-width: 46ch;
        padding: 0 20px;
        text-wrap: balance;
      "
    >
      Делаем проект под вашу задачу так, чтобы клиенты находили вас сами
    </p>

    <!-- Contact button (below heading) -->
    <button
      id="hero-contact-btn"
      class="hero-cta rounded-full flex items-center justify-center flex-shrink-0"
      style="
        width: clamp(60px, 5.83vw, 84px);
        height: clamp(60px, 5.83vw, 84px);
        background-color: #F5F5F5;
        color: #010101;
      "
      aria-label="Связаться"
    >
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>

    <!-- Call to action text (bottom of viewport) -->
    <p
      class="hero-caption font-mono font-medium text-white text-center"
      style="
        font-size: clamp(12px, 1.17vw, 16.8px);
        line-height: 1.55;
      "
    >
      Опишите, что болит, а мы предложим решение и&nbsp;прототип бесплатно.
    </p>
  </div>
</section>

<script>
  // Check prefers-reduced-motion before autoplaying
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement;

  if (!prefersReducedMotion) {
    heroVideo?.play().catch(() => {
      // Gracefully handle play() rejection
    });
  } else {
    const runeVideo = document.getElementById('rune-icon') as HTMLVideoElement;
    runeVideo?.removeAttribute('autoplay');
    runeVideo?.pause();
  }

  // Contact button opens dialog
  const heroBtn = document.getElementById('hero-contact-btn');
  heroBtn?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open-contact-dialog'));
  });

  // Character-by-character animation for h1
  if (!prefersReducedMotion) {
    const h1 = document.querySelector('h1');
    if (h1) {
      let globalCharIndex = 0;

      // Process each span.block (each line) separately to preserve color
      h1.querySelectorAll('span.block').forEach((lineSpan) => {
        const text = lineSpan.textContent;
        lineSpan.textContent = ''; // Clear only this line's text

        text.split('').forEach((char) => {
          const charSpan = document.createElement('span');
          charSpan.textContent = char;
          charSpan.className = 'char-in';
          charSpan.style.display = 'inline';
          charSpan.style.animationDelay = `${500 + globalCharIndex * 26}ms`;
          charSpan.style.color = 'inherit'; // Inherit from parent span.block
          lineSpan.appendChild(charSpan);
          globalCharIndex++;
        });
      });
    }
  }
</script>

<style>
  .hero-stack {
    --s: calc((100svh - 306px - 16.7vw) / 1.115);
  }
  .hero-video-zone {
    --hw: min(338px, 86.6vw);
    --bw: min(var(--hw), var(--s));
    --bh: calc(var(--bw) * 1280 / 1026);
    --zh: min(363px, var(--s));
    width: 100%;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 16px;
    height: var(--zh);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-video-box {
    position: relative;
    width: var(--bw);
    aspect-ratio: 1026 / 1280;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Warm halo with a transparent center: depth around the head, never on it */
  .hero-video-box::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(closest-side,
      rgba(249, 115, 22, 0)    0%,
      rgba(249, 115, 22, 0)    52%,
      rgba(249, 115, 22, 0.13) 68%,
      rgba(194, 65, 12, 0.06)  82%,
      rgba(194, 65, 12, 0)     94%);
  }
  #hero-video {
    object-fit: cover;
    object-position: 50% 0%;
    filter: contrast(1.12) saturate(1.06);
    -webkit-mask-image:
      linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%),
      linear-gradient(to bottom, #000 0, #000 88%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%),
      linear-gradient(to bottom, #000 0, #000 88%, transparent 100%);
    mask-composite: intersect;
  }
  .hero-chip {
    top: calc((var(--zh) - var(--bh)) / 2 + var(--bh) * var(--fy));
    pointer-events: none;
    z-index: 20;
  }
  .hero-chip--l {
    left: max(3px, calc(50% - var(--hw) / 2 + var(--hw) * var(--fh)));
  }
  .hero-chip--r {
    right: max(3px, calc(50% - var(--hw) / 2 + var(--hw) * var(--fh)));
  }
  .hero-section {
    padding-top: clamp(48px, 4.5vw, 84px);
  }
  .hero-chip__pill {
    height: clamp(38px, 3.17vw, 46px);
    font-size: clamp(12px, 1.17vw, 16.8px);
  }
  .hero-h1 {
    font-size: clamp(30px, 10vw, 92px);
    margin-top: clamp(12px, 1.37vw, 22px);
    padding: 0 16px;
  }
  .hero-facts {
    margin-top: clamp(-6px, -0.6vw, -36px);
  }
  .hero-sub {
    margin-top: clamp(12px, 1.2vw, 20px);
  }
  .hero-cta {
    margin-top: clamp(18px, 2.08vw, 36px);
  }
  .hero-caption {
    max-width: 234px;
    margin-top: clamp(9px, 0.9vw, 18px);
  }
  @media (max-width: 767px) {
    .hero-stack {
      justify-content: flex-start;
      padding-top: calc(42px + 0.115 * min(363px, var(--s)) + max(0px, (100svh - 844px) / 2));
    }
    .hero-facts {
      margin-top: 11px;
    }
    .hero-h1 {
      margin-top: -5px;
    }
    .hero-sub {
      margin-top: 7px;
    }
    .hero-cta {
      margin-top: 23px;
    }
    .hero-caption {
      max-width: 252px;
    }
    .hero-chip:last-child {
      top: min(
        max(
          calc((var(--zh) - var(--bh)) / 2 + var(--bh) * var(--fy)),
          calc((var(--zh) - var(--bh)) / 2 + var(--bh) * var(--fg) + 40px)
        ),
        calc(100% - 31px)
      );
    }
  }
  @media (max-width: 359px) {
    .hero-h1 {
      padding: 0 8px;
    }
    .hero-chip__pill {
      padding-left: 12px;
      padding-right: 12px;
      font-size: 11px;
      height: 34px;
    }
  }
  @media (max-height: 500px) {
    .hero-chip {
      display: none;
    }
  }
  @media (min-width: 431px) and (max-width: 767px) and (max-height: 610px) {
    .hero-chip {
      display: none;
    }
  }
  @media (max-width: 430px) and (max-height: 555px) {
    .hero-chip {
      display: none;
    }
  }
  @media (min-width: 768px) {
    .hero-section {
      padding-top: min(clamp(48px, 4.5vw, 84px), max(40px, 5.5svh, calc(17.1svh - 88.5px)));
    }
    .hero-h1 {
      font-size: clamp(30px, min(10vw, 11svh), 92px);
      margin-top: min(clamp(12px, 1.37vw, 22px), max(8px, 1.4svh, calc(6.9svh - 42.2px)));
    }
    .hero-sub {
      margin-top: min(clamp(12px, 1.2vw, 20px), max(8px, 1.4svh, calc(5svh - 27.5px)));
    }
    .hero-cta {
      margin-top: min(clamp(18px, 2.08vw, 36px), max(14px, 2.4svh, calc(8.8svh - 49px)));
    }
    .hero-facts {
      margin-top: max(-6px, min(6px, calc(6px - (100svh - 800px) * 0.12)));
    }
    .hero-video-zone {
      height: min(clamp(300px, 36vw, 518px), 38svh);
    }
    .hero-video-box {
      width: min(clamp(300px, 36vw, 518px), 38svh);
    }
    .hero-chip {
      left: var(--dl);
      right: auto;
      top: min(var(--dt), calc(100% - 46px));
    }
    .hero-caption {
      max-width: 420px;
      text-wrap: balance;
    }
  }
  @media (min-width: 768px) and (max-height: 641px) {
    .hero-caption {
      margin-top: min(clamp(9px, 0.9vw, 18px), 16.5px);
    }
  }
  @media (min-width: 768px) and (max-height: 800px) {
    .hero-video-zone {
      height: min(clamp(300px, 36vw, 518px), 36svh);
    }
    .hero-video-box {
      width: min(clamp(300px, 36vw, 518px), 36svh);
    }
  }
  @media (min-width: 768px) and (max-height: 720px) {
    .hero-video-zone {
      height: min(clamp(300px, 36vw, 518px), 35svh);
    }
    .hero-video-box {
      width: min(clamp(300px, 36vw, 518px), 35svh);
    }
  }
  @media (min-width: 768px) and (max-height: 700px) {
    .hero-video-zone {
      height: min(clamp(300px, 36vw, 518px), 33svh);
    }
    .hero-video-box {
      width: min(clamp(300px, 36vw, 518px), 33svh);
    }
  }
  @media (min-width: 768px) and (max-width: 799px) {
    .hero-section {
      padding-top: 48px;
    }
  }
  @media (min-width: 768px) and (max-width: 819px) and (min-height: 576px) and (max-height: 640px) {
    .hero-section {
      padding-top: 60px;
    }
  }
  @media (min-width: 768px) and (max-height: 575px) {
    .hero-chip {
      display: none;
    }
  }
  @media (min-width: 1290px) and (max-height: 599px), (min-width: 1420px) and (max-height: 607px) {
    .hero-chip {
      display: none;
    }
  }

  .rune-glow {
    display: inline-flex;
    filter:
      drop-shadow(0 0 5px rgba(249, 115, 22, 0.65))
      drop-shadow(0 0 12px rgba(234, 88, 12, 0.40));
  }
  #rune-icon {
    filter: contrast(1.08) saturate(1.12);
    -webkit-mask-image: radial-gradient(closest-side, #000 56%, rgba(0,0,0,0.7) 76%, transparent 97%);
    mask-image: radial-gradient(closest-side, #000 56%, rgba(0,0,0,0.7) 76%, transparent 97%);
  }

  #hero-contact-btn {
    position: relative;
    isolation: isolate;
    transition:
      transform 160ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }
  #hero-contact-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 220ms var(--ease-out);
    background-image: linear-gradient(110deg,
      #C2410C  0%,
      #EA580C 14%,
      #F97316 30%,
      #FDBA74 42%,
      #FFF7ED 48%,
      #FB923C 58%,
      #F97316 72%,
      #EA580C 88%,
      #C2410C 100%);
    background-size: 300% 100%;
    background-position: 0% 50%;
    box-shadow:
      inset 0 2px 6px rgba(255, 255, 255, 0.55),
      inset 0 -8px 14px rgba(124, 45, 18, 0.38);
    animation: hero-btn-sheen 2600ms linear infinite;
    animation-play-state: paused;
  }
  @keyframes hero-btn-sheen {
    from { background-position: 0% 50%; }
    to   { background-position: 100% 50%; }
  }
  #hero-contact-btn svg {
    transition: transform 320ms var(--ease-out);
    transform-origin: 50% 50%;
  }
  @media (hover: hover) {
    #hero-contact-btn:hover { transform: scale(1.04); box-shadow: 0 10px 30px -8px rgba(249,115,22,0.55); }
    #hero-contact-btn:hover::before { opacity: 1; animation-play-state: running; }
    #hero-contact-btn:hover svg { transform: rotate(180deg); }
  }
  #hero-contact-btn:focus-visible {
    outline: 2px solid #F97316;
    outline-offset: 4px;
    transform: scale(1.04);
    box-shadow: 0 10px 30px -8px rgba(249, 115, 22, 0.55);
  }
  #hero-contact-btn:focus-visible::before { opacity: 1; animation-play-state: running; }
  #hero-contact-btn:focus-visible svg { transform: rotate(180deg); }
  #hero-contact-btn:active { transform: scale(0.97); }
  @media (prefers-reduced-motion: reduce) {
    #hero-contact-btn::before { animation: none; }
    #hero-contact-btn:hover,
    #hero-contact-btn:focus-visible,
    #hero-contact-btn:active { transform: none; }
    #hero-contact-btn:hover svg,
    #hero-contact-btn:focus-visible svg { transform: none; }
  }

  @keyframes char-in {
    from {
      opacity: 0;
      filter: blur(8px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  :global(.char-in) {
    animation: char-in 0.5s ease forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.char-in) {
      animation: none;
      opacity: 1;
      filter: none;
    }
  }
</style>
