---
import SectionTitle from '../ui/SectionTitle.astro';

interface Metric {
  prefix?: string;
  value: number;
  suffix?: string;
  description: string;
  animate?: boolean;
}

interface Solution {
  title: string;
  who: string;
  task: string;
  solution: string;
  metrics: Metric[];
}

const solutions: Solution[] = [
  {
    title: 'Спецификация → черновик КП',
    who: 'Поставщики и дистрибьюторы стройматериалов и инженерного оборудования',
    task: 'Клиент присылает запрос или спецификацию, названия и артикулы не совпадают с каталогом. На одно КП у менеджера уходит от получаса до часа.',
    solution: 'ИИ разбирает запрос из письма, мессенджера или формы, находит каждой позиции товар в каталоге 1С и на остатках, предлагает аналоги и собирает черновик КП. Менеджер только проверяет готовый документ.',
    metrics: [
      { prefix: '3–', value: 5, suffix: ' мин', animate: false, description: 'на одно КП вместо 30–⁠60 минут' },
      { prefix: 'свыше ', value: 98, suffix: '%', description: 'точность подбора номенклатуры, было около 85%' },
      { prefix: 'менее ', value: 1, suffix: '%', description: 'КП с ошибками в ценах и артикулах, было до 10%' },
    ],
  },
  {
    title: 'Разбор тендерной документации',
    who: 'Заказчики, которые проверяют заявки подрядчиков, и участники торгов по 44‑ФЗ, 223‑ФЗ и коммерческих тендеров',
    task: 'Пакет документов — сотни страниц. Требования, сроки и риски выписывают вручную: заказчик подолгу проверяет заявки, участник долго решает, идти ли в торги, а ошибка в заявке ведёт к отклонению.',
    solution: 'ИИ читает пакет, выписывает требования, сроки и риски и сверяет с ними документы — подрядчика или свои: показывает, чего не хватает и что не соответствует. Решение остаётся за человеком.',
    metrics: [
      { prefix: '×', value: 5, description: 'быстрее проверка заявок подрядчиков на соответствие требованиям' },
      { value: 93, suffix: '%', description: 'точность извлечения требований по сверке с разметкой экспертов' },
      { prefix: 'до ', value: 7, suffix: ' мин', description: 'на проверку 50‑страничного документа подрядчика' },
    ],
  },
  {
    title: 'ИИ-консультант 24/7 по каталогу',
    who: 'Продавцы стройматериалов, спецтехники и запчастей, застройщики',
    task: 'Ответ на заявку приходит через полчаса, ночью и в выходные заявки никто не обрабатывает — клиент уходит к тому, кто ответил первым.',
    solution: 'ИИ-агент отвечает по каталогу компании на сайте и в мессенджерах, уточняет задачу и сроки, собирает контакт и передаёт готовую заявку в CRM. Нестандартные вопросы передаёт менеджеру.',
    metrics: [
      { prefix: 'менее ', value: 1, suffix: ' мин', description: 'до первого ответа вместо 33 минут' },
      { value: 18, suffix: '%', description: 'конверсия обращения в заказ, было 13%' },
      { value: 72, description: 'заявки, обработанные в нерабочее время за первый месяц, было 0' },
    ],
  },
  {
    title: 'Речевая аналитика звонков',
    who: 'Отделы продаж девелоперов, агентств недвижимости и поставщиков',
    task: 'Руководитель вручную слушает 5–⁠10% звонков и не видит, на каком шаге теряются сделки.',
    solution: 'ИИ расшифровывает все звонки, оценивает каждый по чек-листу, находит типовые ошибки — нет следующего шага, формальные ответы на вопросы клиента — и собирает отчёт для руководителя.',
    metrics: [
      { prefix: '+', value: 34, suffix: '%', description: 'конверсия звонка во встречу после тренингов по находкам ИИ' },
      { prefix: '+', value: 9, suffix: ' млн ₽', description: 'продаж за квартал (+2 сделки)' },
      { value: 100, suffix: '%', description: 'звонков проверено; при ручном контроле обычно 5–⁠10%' },
    ],
  },
];

---
<section id="ai-cases" class="py-24 md:py-32 border-t border-dark-divider">
  <div class="max-w-6xl mx-auto px-5 md:px-8">
    <SectionTitle number="03 /">
      ИИ в <span class="text-accent-on-dark">РЕАЛЬНЫХ</span> задачах
    </SectionTitle>

    <p class="text-lg leading-relaxed text-on-dark-body max-w-[65ch] mb-12 md:mb-16">
      Такие решения возможны и&nbsp;для&nbsp;вашего бизнеса — вот что они&nbsp;дают.
    </p>

    <div class="space-y-12">
      {solutions.map(({ title, who, task, solution, metrics }) => (
        <article class="pb-12 border-b border-dark-divider last:border-b-0 grid grid-cols-1 md:grid-cols-3 gap-x-8">
          <div class="md:col-span-2">
            <h3 class="text-3xl font-normal font-heading text-on-dark mb-6">{title}</h3>
            <div class="space-y-4">
              <div>
                <h4 class="text-sm font-bold font-mono text-on-dark-muted mb-2 uppercase tracking-[0.14em]">ДЛЯ КОГО</h4>
                <p class="text-on-dark-body max-w-[65ch]">{who}</p>
              </div>
              <div>
                <h4 class="text-sm font-bold font-mono text-on-dark-muted mb-2 uppercase tracking-[0.14em]">РЕШЕНИЕ</h4>
                <p class="text-on-dark-body max-w-[65ch]">{solution}</p>
              </div>
            </div>
          </div>

          <details class="md:col-span-3">
            <summary style="display: none;"></summary>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-6 pt-8">
              <div class="md:col-span-2">
                <h4 class="text-sm font-bold font-mono text-on-dark-muted mb-2 uppercase tracking-[0.14em]">ЗАДАЧА</h4>
                <p class="text-on-dark-body max-w-[65ch]">{task}</p>
              </div>
              <div class="flex flex-col items-start gap-6">
                <h4 class="text-sm font-bold font-mono text-on-dark-muted uppercase tracking-[0.14em]">ВОЗМОЖНЫЙ РЕЗУЛЬТАТ</h4>
                {metrics.map(({ prefix, value, suffix, description, animate }) => (
                  <div class="flex flex-col gap-1">
                    <div class="font-heading text-on-dark whitespace-nowrap" style="font-size: clamp(24px, 2.2vw, 30px); line-height: 1;">
                      {prefix}{animate === false ? value : <span class="ai-count inline-block tabular-nums" data-count={value}>{value}</span>}{suffix}
                    </div>
                    <div class="font-mono text-sm leading-snug text-on-dark-muted max-w-[34ch]">
                      {description}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </details>

          <button
            type="button"
            data-ai-toggle
            aria-expanded="false"
            class="md:col-span-3 justify-self-start mt-6 inline-flex items-center gap-2 min-h-[44px] text-on-dark-body hover:text-accent-on-dark transition-colors duration-300"
          >
            <span data-ai-label>Подробнее</span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              data-ai-arrow
              class="inline-block flex-shrink-0 text-accent-on-dark transition-transform duration-300"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-ai-toggle]').forEach((button) => {
    const details = button.closest('article')?.querySelector('details');
    const label = button.querySelector('[data-ai-label]');
    const arrow = button.querySelector<SVGElement>('[data-ai-arrow]');
    if (!details || !label || !arrow) return;

    button.addEventListener('click', () => {
      details.open = !details.open;
    });
    details.addEventListener('toggle', () => {
      button.setAttribute('aria-expanded', String(details.open));
      label.textContent = details.open ? 'Свернуть' : 'Подробнее';
      arrow.style.transform = details.open ? 'rotate(-90deg)' : '';
    });
  });

  const counters = [...document.querySelectorAll<HTMLElement>('.ai-count')].filter((el) => Number(el.dataset.count) >= 2);
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced && 'IntersectionObserver' in window) {
    const DURATION = 1400;
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 4);

    const countUp = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / DURATION);
        el.textContent = String(Math.round(target * easeOut(t)));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        countUp(entry.target as HTMLElement);
      }
    }, { threshold: 0.5 });

    for (const el of counters) {
      el.textContent = '0';
      observer.observe(el);
    }

    addEventListener('beforeprint', () => {
      for (const el of counters) el.textContent = el.dataset.count ?? '';
    });
  }
</script>
