---
import { Image } from 'astro:assets';
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';
import processImage from '../../assets/process.jpg';
---

<section id="process" class="py-24 md:py-32 border-t border-dark-divider">
  <div class="max-w-6xl mx-auto px-5 md:px-8">
    <SectionTitle number="04 /">
      <span class="text-accent-on-dark">КАК</span> мы работаем
    </SectionTitle>

    <div class="grid grid-cols-1 md:grid-cols-[1fr_0.8fr] gap-12 items-start mb-12">
      <div class="space-y-8">
        {[
          { step: '01', title: 'Знакомимся', desc: 'Встречаемся и разговариваем о вашем бизнесе: чем живёте, что болит, куда хотите прийти.' },
          { step: '02', title: 'Проводим аудит', desc: 'Разбираем проект и бизнес-процессы: цифры, конкурентов, как к вам приходят клиенты.' },
          { step: '03', title: 'Находим ваше УТП', desc: 'Выявляем сильные стороны и то, чем вы отличаетесь от других — на этом строится весь продукт.' },
          { step: '04', title: 'Делаем прототип — бесплатно', desc: 'Собираем рабочий прототип на основе аудита. Вы ничего не платите на этом этапе.', highlight: true },
          { step: '05', title: 'Показываем — решаете вы', desc: 'Понравился прототип — покупаете, и мы доводим его до полноценного продукта. Не понравился — вы ничего не потеряли.' },
        ].map(({ step, title, desc, highlight }) => (
          <div class={`relative pl-16 pb-8 last:pb-0 ${highlight ? 'rounded-xl py-6 pr-6 pl-16 bg-accent-wash' : ''}`}>
            <div class={`absolute ${highlight ? 'left-6 top-6' : 'left-0 top-0'} font-mono font-bold text-base tracking-wide ${highlight ? 'text-accent-on-dark' : 'text-on-dark-muted'}`}>
              {step}
            </div>
            <h3 class="text-lg font-normal font-heading text-on-dark mb-2 items-baseline">{title}</h3>
            <p class="text-on-dark-body leading-relaxed max-w-[65ch] text-base">{desc}</p>
          </div>
        ))}
      </div>

      <div class="w-full hidden md:block">
        <Image
          src={processImage}
          alt="Путь от встречи к бесплатному прототипу"
          width={1600}
          format="webp"
          loading="lazy"
          decoding="async"
          class="w-full h-auto border border-dark-line rounded-2xl"
          style="filter: brightness(.55) contrast(1.15) saturate(.9);"
        />
      </div>
    </div>

    <div class="space-y-6">
      <p class="text-lg leading-relaxed text-on-dark-body max-w-[65ch]">
        <span class="font-bold text-on-dark">Бесплатный прототип</span> — наше уникальное предложение: вы принимаете решение, глядя на готовый продукт, а не на обещания.
      </p>
      <Button size="lg" variant="primary-cta" class="open-contact-dialog cursor-pointer">
        Начать со встречи
      </Button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.open-contact-dialog').forEach((button) => {
    button.addEventListener('click', () => {
      window.dispatchEvent(new Event('open-contact-dialog'));
    });
  });
</script>
