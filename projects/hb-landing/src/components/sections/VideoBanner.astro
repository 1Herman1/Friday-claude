---
import Button from '../ui/Button.astro';

const BASE_URL = import.meta.env.BASE_URL;
---

<section class="w-full py-0 bg-dark relative overflow-hidden h-auto max-h-none aspect-[4/5] md:h-screen md:max-h-screen md:aspect-auto flex items-center justify-center border-t border-[rgba(244,244,241,0.14)]">
  <video
    id="banner-video"
    class="absolute inset-0 w-full h-full object-cover"
    muted
    loop
    playsinline
    preload="none"
    poster={`${BASE_URL}media/banner/build-your-dream.jpg`}
  >
    <source src={`${BASE_URL}media/banner/build-your-dream.mp4`} type="video/mp4" />
  </video>

  <div class="absolute inset-0 bg-dark/45 [background-image:linear-gradient(to_bottom,transparent_65%,var(--color-dark))]"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-5 md:px-8 text-center">
    <div class="mb-6">
      <h2 class="text-[3rem] md:text-[7rem] lg:text-[9rem] font-normal font-heading text-on-dark uppercase leading-none">
        Build your dream <span class="text-accent-on-dark">/</span>
      </h2>
    </div>
    <div class="flex justify-center">
      <Button size="lg" variant="primary" href="https://t.me/h_and_b_team">Написать в Telegram</Button>
    </div>
  </div>
</section>

<script>
  const video = document.getElementById('banner-video') as HTMLVideoElement;
  const BASE_URL = import.meta.env.BASE_URL;

  // Respect prefers-reduced-motion
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            if (!video.poster) {
              video.poster = `${BASE_URL}media/banner/build-your-dream.jpg`;
            }
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.25 }
    );

    observer.observe(video);
  } else {
    // prefers-reduced-motion: set poster to show a static frame
    video.poster = `${BASE_URL}media/banner/build-your-dream.jpg`;
  }
</script>
