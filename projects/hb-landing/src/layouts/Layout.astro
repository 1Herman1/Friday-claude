---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Герман Брызгалов — разработка IT-продуктов и внедрение ИИ | H&B team',
  description = 'H&B team разрабатывает веб-сервисы, порталы, SaaS-решения, интернет-магазины и внедряет искусственный интеллект. Разработка от идеи до запуска.',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hb-team.dev" />
    <meta name="theme-color" content="#FAFAF8" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
