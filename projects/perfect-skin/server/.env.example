# PostgreSQL connection string
PS_DATABASE_URL="postgresql://user:password@localhost:5432/perfect_skin"

# HTTP-only cookie for guest sessions
PS_COOKIE_SECRET="change-me-in-production"

# Signing key for the auth token. The server refuses to start in production
# without it (src/index.ts). Note the missing PS_ prefix: unlike the others,
# this name is read as-is by the code.
JWT_SECRET="change-me-in-production"

# CORS origins (comma-separated)
PS_CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# HMAC secret for per-user promo code limits
PS_PROMO_HMAC_SECRET="change-me-in-production"

# Environment
NODE_ENV="development"

# SMS provider: dev | sendpulse | other
SMS_PROVIDER="dev"
SMS_API_KEY=""
SMS_SENDER=""

# Professional access: document storage
# In development defaults to ./var/pro-docs, in production required
PS_PRO_DOCS_DIR="./var/pro-docs"

# Professional access: manager notification email (optional)
# When a pending application is submitted, send notification to this address
PS_PRO_NOTIFY_EMAIL=""
