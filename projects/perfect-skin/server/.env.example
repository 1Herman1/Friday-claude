# PostgreSQL connection string
PS_DATABASE_URL="postgresql://user:password@localhost:5432/perfect_skin"

# HTTP-only cookie for guest sessions
PS_COOKIE_SECRET="change-me-in-production"

# Signing key for the auth token. The server refuses to start in production
# without it (src/index.ts). Note the missing PS_ prefix: unlike the others,
# this name is read as-is by the code.
JWT_SECRET="change-me-in-production"

# CORS origins (comma-separated)
PS_CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# HMAC secret for per-user promo code limits
PS_PROMO_HMAC_SECRET="change-me-in-production"

# Environment
NODE_ENV="development"

# SMS provider: dev | sendpulse | other
SMS_PROVIDER="dev"
SMS_API_KEY=""
SMS_SENDER=""

# Professional access: document storage
# In development defaults to ./var/pro-docs, in production required
PS_PRO_DOCS_DIR="./var/pro-docs"

# Professional access: manager notification email (optional)
# When a pending application is submitted, send notification to this address
PS_PRO_NOTIFY_EMAIL=""

# Telegram bot for notifications (optional)
PS_TG_BOT_TOKEN=""
PS_TG_BOT_USERNAME=""

# Public site URL without trailing slash: links in Telegram buttons (required if bot enabled),
# canonical, og:url, sitemap.xml and robots.txt. Empty = origin of the request (only while indexing is closed).
# Required with PS_INDEXING="on": without it indexing stays closed and the server logs a warning.
PS_PUBLIC_URL=""

# SEO indexing switch. Anything but "on" keeps the whole site closed: robots.txt disallows all,
# every page gets noindex. "on" works only together with PS_PUBLIC_URL (see above): without it the site stays closed.
# Flip together with indexing in nginx (deploy/perfect-skin-indexing.conf).
PS_INDEXING="off"

# Built client index.html that the server fills with title, meta and body markup for crawlers.
# Production default: /var/www/perfect-skin/client/index.html. Local check: the client build output.
PS_CLIENT_INDEX="../client/dist/index.html"

# Video reviews: folder with published videos and posters (the app decides who sees a file,
# Nginx serves it via X-Accel-Redirect) and private folder for consent documents (never served).
# In development default to ./var/video-reviews and ./var/video-consents, in production required
PS_VIDEO_REVIEWS_DIR="./var/video-reviews"
PS_VIDEO_CONSENTS_DIR="./var/video-consents"
