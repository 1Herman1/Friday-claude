// Perfect Skin — схема БД.
//
// ВАЖНО: это ОТДЕЛЬНАЯ база от магазина Симба. Своя переменная окружения
// (PS_DATABASE_URL, не DATABASE_URL) и свой сгенерированный клиент — чтобы
// миграция этого проекта физически не могла задеть работающий магазин кормов.
// Обоснование разделения — docs/decisions/2026-07-perfect-skin-architecture.md

generator client {
  provider = "prisma-client-js"
  output   = "../../../../node_modules/.prisma/ps-client"
}

datasource db {
  provider = "postgresql"
  url      = env("PS_DATABASE_URL")
}

// ─────────────────────────────── Перечисления ───────────────────────────────

/// Роли сотрудников и покупателей.
enum UserRole {
  super_admin
  orders_manager
  products_manager
  content_manager
  customer
  professional
}

/// Статус заявки косметолога на профессиональный доступ.
enum ProStatus {
  none
  pending
  approved
  rejected
}

enum OtpChannel {
  email
  sms
}

enum SkinType {
  normal
  dry
  oily
  combination
  sensitive
  mature
  all_types
}

/// Задача, которую решает средство.
enum Concern {
  hydration
  anti_age
  pigmentation
  acne
  sensitivity
  redness
  cleansing
  sun_protection
  firming
  eye_area
  post_procedure
  regeneration
  radiance
  sebum_control
  hygiene
  barrier
  daily_care
  express_care
  intensive_care
  nourishing
  oxidative_stress
}

/// Единица фасовки: мл для флаконов, г для банок, шт для наборов.
enum VolumeUnit {
  ml
  g
  pcs
}

enum FilterType {
  checkbox
  range
  select
}

enum OrderStatus {
  new
  confirmed
  packed
  in_transit
  delivered
  cancelled
}

/// Пункт выдачи и курьер разделены: у них разные пороги бесплатной доставки
/// (6 000 ₽ и 10 000 ₽).
enum DeliveryMethod {
  cdek_pvz
  cdek_courier
  pickup
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

/// Состояние ПЕРЕДАЧИ заказа в СДЭК (наша сторона), не статус доставки.
enum CdekSyncState {
  creating // передача захвачена (защита от двойного нажатия), запрос в полёте
  accepted // СДЭК принял запрос, cdek_number ещё нет
  created // есть cdek_number = трек
  invalid // СДЭК отклонил, текст в cdekError; можно передать повторно
}

/// Кому виден материал Бьюти-клуба.
enum Audience {
  public
  retail
}

/// Тип публикации: статья или новость.
enum PostKind {
  article
  news
}

enum BannerPage {
  home
  catalog
  brand
  club
  other
}

enum BannerPosition {
  main_slider
  promo_strip
  sidebar
}

enum ConsultationStatus {
  new
  contacted
  scheduled
  done
  cancelled
}

enum ConsentPurpose {
  pro_application // обработка данных заявки специалиста, включая копию документа
  marketing // рекламная рассылка
  consultation // обработка ПДн для обратной связи (консультация)
  health_data // обработка данных о состоянии кожи для консультации
  care // обработка ПДн, чтобы связаться по заявке Отдела заботы
  account // обработка ПДн при входе в кабинет
  loyalty // принятие Правил Бьюти-клуба (участие в программе лояльности)
}

/// Тип операции бонусного счёта. review и birthday заложены на будущее:
/// код их не создаёт (отзывов нет, дату рождения не собираем — новая цель ПДн).
enum BonusTxType {
  welcome                // приветственные при вступлении (+)
  order_accrual          // начисление за заказ (+)
  order_spend            // списание в заказе (−)
  order_spend_refund     // возврат списанного при отмене/возврате (+)
  order_accrual_reversal // отмена начисления при возврате (−)
  expiration             // сгорание остатка партии (−)
  manual_adjustment      // ручная корректировка сотрудником (±), причина и автор обязательны
  review                 // задел: бонус за отзыв (+)
  birthday               // задел: бонус ко дню рождения (+)
}

/// От чего считается начисление.
enum BonusAccrualBase {
  paid_goods  // товары − промокод − бонусы (по умолчанию)
  after_promo // товары − промокод
  gross       // товары без скидок
}

/// Когда начисление становится доступным (+ accrualDelayDays).
enum BonusAccrualTrigger {
  delivered
  paid
}

/// Тип исходящего письма: для advertising согласие marketing проверяется в момент отправки.
enum MessageKind {
  service
  advertising
}

/// Источник решения по заявке: автоматическая или ручная обработка.
enum ProDecisionSource {
  auto_msp // автоматическое одобрение по реестру МСП
  manual // ручная обработка менеджером
}

// ──────────────────────── Пользователи и доступ ────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String?
  phone           String?
  name            String
  passwordHash    String? // только сотрудники
  login           String?   @unique // только сотрудники, вход по паролю
  role            UserRole  @default(customer)
  isActive        Boolean   @default(true)
  acceptedTermsAt DateTime? // согласие на обработку ПДн — храним документы

  /// Версия сессий. Сверяется при каждом запросе: увеличение мгновенно
  /// обесценивает все выданные токены. Без этого понижение роли или блокировка
  /// сотрудника вступали бы в силу только через 7 дней — срок жизни JWT.
  tokenVersion Int @default(0)

  /// Троттлинг входа считается на ПОЛЬЗОВАТЕЛЯ, а не на код: иначе перебор
  /// обходится запросом нового кода — счётчик попыток обнулялся бы вместе с ним.
  otpFailedCount  Int       @default(0)
  otpBlockedUntil DateTime?

  /// Заявка на профессиональный доступ. Оптовая цена выдаётся ТОЛЬКО при
  /// role = professional И proStatus = approved — обе проверки на сервере.
  proStatus         ProStatus          @default(none)
  companyName       String?
  inn               String?
  ogrnip            String? // опциональный ОГРНИП/ОГРН (15 или 13 цифр) для ИП/ООО
  specialization    String?
  proRequestedAt    DateTime?
  proReviewedAt     DateTime?
  proReviewerId     String?
  proRejectReason   String?
  proDecisionSource ProDecisionSource? // источник последнего решения (auto_msp или manual)
  proCheck          Json? // результат автопроверки для менеджера: { lane, registry, npd, checkedAt }
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  addresses        Address[]
  orders           Order[]
  cart             Cart?
  otpCodes         OtpCode[]
  favorites        Favorite[]
  ownedPromoCodes  PromoCode[]           @relation("PromoOwner")
  promoRedemptions PromoCodeRedemption[]
  offerAssignments OfferAssignment[]
  skinSurveys      SkinSurvey[]
  consultations    ConsultationRequest[]
  consents         ConsentRecord[]
  proDocuments     ProDocument[]
  telegramLinks    TelegramLink[]
  videoReviewsConsentConfirmed VideoReview[] @relation("VideoReviewConsentBy")
  videoReviewsConsentRevoked   VideoReview[] @relation("VideoReviewConsentRevokedBy")
  videoReviewsContentReviewed  VideoReview[] @relation("VideoReviewContentReviewedBy")
  bonusAccount           BonusAccount?
  bonusTxCreated         BonusTransaction[]      @relation("BonusTxCreatedBy")
  loyaltySettingsUpdated LoyaltySettings[]       @relation("LoyaltySettingsUpdatedBy")
  loyaltySettingsChanges LoyaltySettingsChange[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

/// Одноразовые коды входа.
/// Отличия от Симбы намеренные: там код лежит открытым, а счётчик попыток живёт
/// в памяти процесса — при рестарте или втором инстансе защита от перебора
/// обнуляется. Здесь хеш и счётчик в БД.
///
/// codeHash — ТОЛЬКО bcrypt или argon2 с солью. Быстрый хеш (sha256) здесь
/// бесполезен: у шестизначного кода миллион вариантов, дамп таблицы
/// перебирается за секунды, и хеширование не даёт ничего.
model OtpCode {
  id        String     @id @default(uuid())
  userId    String
  codeHash  String
  channel   OtpChannel
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("otp_codes")
}

model Address {
  id         String    @id @default(uuid())
  userId     String
  label      String
  city       String
  street     String
  house      String
  apartment  String?
  postalCode String
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────── Каталог ───────────────────────────────

model Category {
  id             String    @id @default(uuid())
  name           String
  slug           String
  description    String?
  image          String?
  parentId       String?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]
  filters  CategoryFilter[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive, deletedAt])
  @@map("categories")
}

/// ISSEIMI и GLACÉE Skincare. Написание строго как в дизайн-системе.
model Brand {
  id             String    @id @default(uuid())
  name           String
  slug           String
  logo           String?
  description    String?
  country        String?   @default("Испания")
  manufacturer   String?   @default("Heber Farma")
  seoTitle       String?
  seoDescription String?
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  lines    ProductLine[]
  products Product[]

  @@index([slug])
  @@map("brands")
}

/// Линейка внутри бренда: ISSEIMI Base, ISSEIMI MD, ISSEIMI Nat Collection,
/// GLACÉE Skincare Man Line. Модель, а не перечисление: новая линейка не должна
/// требовать миграции.
model ProductLine {
  id             String    @id @default(uuid())
  brandId        String
  name           String
  slug           String
  description    String?
  image          String?
  seoTitle       String?
  seoDescription String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([brandId, name])
  @@index([brandId])
  @@index([slug])
  @@map("product_lines")
}

/// Активный компонент. Отдельная модель, потому что это и фильтр каталога,
/// и точка входа из поиска («средства с ретинолом»).
model Ingredient {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductIngredient[]

  @@map("ingredients")
}

/// Товар. Зоо-полей Симбы (белки, жиры, беззерновой корм) здесь нет —
/// вместо них характеристики косметики.
model Product {
  id               String     @id @default(uuid())
  name             String
  slug             String
  previousSlugs    String[]   @default([]) // старые адреса товара: продолжают открывать его после переименования
  shortDescription String?
  description      String
  brandId          String?
  lineId           String?
  images           String[]
  skinTypes        SkinType[]
  concerns         Concern[]
  usage            String?
  inciText         String? // полный состав как на этикетке
  details          Json? // карточка «Аптечная карта», формат — lib/product-details.ts; null = текст из description/usage
  seoTitle         String?
  seoDescription   String?
  minPrice         Int        @default(0) // минимальная розничная цена активных фасовок, копейки
  maxPrice         Int        @default(0) // максимальная розничная цена активных фасовок, копейки
  isActive         Boolean    @default(true)
  isFeatured       Boolean    @default(false)
  popularPin       Int? // позиция в закреплённых популярных товарах (null = не закреплён)
  isProfessional   Boolean    @default(false) // кабинетная позиция: цену видят только специалисты
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  brand        Brand?               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  line         ProductLine?         @relation(fields: [lineId], references: [id], onDelete: SetNull)
  categories   ProductCategory[]
  variants     ProductVariant[]
  ingredients  ProductIngredient[]
  filterValues ProductFilterValue[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  favorites    Favorite[]
  videoReviews VideoReview[]

  @@index([slug])
  @@index([brandId])
  @@index([lineId])
  @@index([isActive, deletedAt, createdAt])
  @@index([minPrice])
  @@index([popularPin])
  @@index([isProfessional])
  @@map("products")
}

/// Фасовка товара. У Симбы здесь вес корма в килограммах — для косметики это
/// вводит в заблуждение, поэтому объём с явной единицей измерения.
model ProductVariant {
  id             String     @id @default(uuid())
  productId      String
  volumeValue    Decimal    @db.Decimal(7, 2)
  volumeUnit     VolumeUnit @default(ml)
  volumeLabel    String? // «набор из 3 средств» — переопределяет вывод
  retailPrice    Int // копейки: 807700 = 8 077 ₽
  oldRetailPrice Int?
  wholesalePrice Int? // оптовая цена для одобренных косметологов, копейки
  isProfessional Boolean    @default(false) // фасовка только для кабинета
  stock          Int        @default(0)
  sku            String?    @unique
  barcode        String?
  weightGrams    Int? // вес в упаковке, г; null = PS_CDEK_ITEM_WEIGHT_G
  externalId     String?    @unique // id в старом WooCommerce для импорта
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, isActive])
  @@index([isActive, deletedAt])
  @@index([retailPrice])
  @@map("product_variants")
}

model ProductCategory {
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductIngredient {
  productId     String
  ingredientId  String
  concentration String? // «2%», «10 000 Da» — единицы разные, поэтому строка
  isKey         Boolean @default(false)
  sortOrder     Int     @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

/// Фильтры, которыми управляет админ. Тип кожи и назначение сюда НЕ дублировать —
/// они уже типизированные поля товара, фасеты для них строятся из перечислений.
model Filter {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  type      FilterType
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  values     FilterValue[]
  categories CategoryFilter[]

  @@map("filters")
}

model FilterValue {
  id        String   @id @default(uuid())
  filterId  String
  value     String
  slug      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  filter   Filter               @relation(fields: [filterId], references: [id], onDelete: Cascade)
  products ProductFilterValue[]

  @@unique([filterId, slug])
  @@index([filterId])
  @@map("filter_values")
}

model ProductFilterValue {
  productId     String
  filterValueId String

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  filterValue FilterValue @relation(fields: [filterValueId], references: [id], onDelete: Cascade)

  @@id([productId, filterValueId])
  @@index([filterValueId])
  @@map("product_filter_values")
}

model CategoryFilter {
  categoryId String
  filterId   String
  sortOrder  Int    @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  filter   Filter   @relation(fields: [filterId], references: [id], onDelete: Cascade)

  @@id([categoryId, filterId])
  @@map("category_filters")
}

// ──────────────────────────── Корзина и заказы ────────────────────────────

/// Гость собирает корзину по sessionId, при входе она сливается с пользовательской.
model Cart {
  id        String   @id @default(uuid())
  userId    String?  @unique
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([updatedAt])
  @@map("carts")
}

/// Цену в корзине НЕ храним: она вычисляется при чтении по прайсу текущего
/// пользователя. Иначе профессиональная цена «залипнет» в корзине после того,
/// как доступ отозвали.
model CartItem {
  id               String   @id @default(uuid())
  cartId           String
  productVariantId String
  productId        String
  quantity         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@index([productId])
  @@index([productVariantId])
  @@map("cart_items")
}

model Order {
  id     String      @id @default(uuid())
  number String      @unique // PS-000123
  userId String
  status OrderStatus @default(new)

  deliveryMethod      DeliveryMethod
  deliveryAddress     Json?
  cdekPvzCode         String?
  deliveryCost        Int            @default(0)
  deliveryTrackNumber String?

  // ── СДЭК ──
  cdekCityCode     Int? // код города назначения в справочнике СДЭК
  cdekTariffCode   Int? // тариф, по которому считали (136/137/368…)
  deliveryPoint    Json? // снимок ПВЗ на момент заказа
  deliveryQuote    Json? // снимок расчёта: источник, сумма, сроки, вес
  cdekUuid         String?           @unique // uuid заказа в СДЭК
  cdekNumber       String?           @unique // номер СДЭК = трек-номер; дублируется в deliveryTrackNumber
  cdekState        CdekSyncState?
  cdekRequestedAt  DateTime? // момент захвата передачи — для восстановления зависших
  cdekError        String? // последняя ошибка СДЭК, ≤ 1000 символов
  cdekStatusCode   String? // последний код статуса доставки СДЭК
  cdekStatusName   String? // его русское название из ответа СДЭК
  cdekStatusAt     DateTime?
  trackEmailSentAt DateTime? // письмо с треком отправлено — идемпотентность
  cdekEvents       CdekStatusEvent[]

  recipientName  String
  recipientPhone String
  recipientEmail String?

  subtotal Int

  promoCodeId    String?
  promoCodeValue String? // снапшот строки кода
  promoPercent   Int? // снапшот процента на момент заказа
  promoDiscount  Int     @default(0)
  total          Int

  paymentStatus PaymentStatus @default(pending)
  paymentId     String?
  paidAt        DateTime?

  comment   String?
  adminNote String?

  // ── Бонусы ──
  bonusSpent          Int       @default(0) // списано бонусов (штуки)
  bonusDiscount       Int       @default(0) // те же бонусы в копейках по курсу на момент заказа
  bonusAccrualPlanned Int       @default(0) // обещано к начислению (штуки), заморожено при создании
  bonusAccrualDueAt   DateTime? // когда начислить; ставится при «доставлен»/«оплачен»
  bonusAccruedAt      DateTime? // когда фактически начислено
  deliveredAt         DateTime? // ставит ТОЛЬКО changeOrderStatus (и для СДЭК тоже)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  promoCode          PromoCode?           @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  redemption         PromoCodeRedemption?
  bonusTransactions  BonusTransaction[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([promoCodeId])
  @@index([cdekState, status]) // выборка фоновой сверки
  @@index([bonusAccrualDueAt])
  @@map("orders")
}

/// История статусов доставки СДЭК. Только добавление (журнал, soft delete не нужен),
/// повторы вебхука и опроса отсекаются уникальным ключом.
model CdekStatusEvent {
  id         String   @id @default(uuid())
  orderId    String
  code       String
  name       String?
  city       String?
  occurredAt DateTime
  source     String // webhook | poll | manual | submit
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, code, occurredAt])
  @@index([orderId, occurredAt])
  @@map("cdek_status_events")
}

/// Снапшот позиции: цена и прайс фиксируются на строке, чтобы возврат считался
/// по той цене, которая была уплачена, а не по текущей.
model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  productVariantId String
  productId        String
  productName      String
  brandName        String?
  volumeLabel      String // «50 мл», уже отформатировано
  price            Int
  quantity         Int
  createdAt        DateTime @default(now())

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId, createdAt])
  @@index([productVariantId])
  @@map("order_items")
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("favorites")
}

// ─────────────────────────────── Промокоды ───────────────────────────────

/// Партнёр (косметолог, реселлер). Для отслеживания выплат по промокодам.
model Partner {
  id                String   @id @default(uuid())
  name              String   @unique
  contact           String?
  commissionPercent Int      @default(0) // процент от прибыли на его промокодах
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  promoCodes PromoCode[]

  @@map("partners")
}

/// Промокод косметолога. У Симбы код захардкожен строкой в расчёте итогов —
/// поэтому там нельзя ни выключить код, ни собрать статистику, ни завести второй
/// без выкладки. Здесь это данные.
model PromoCode {
  id             String    @id @default(uuid())
  code           String // хранится в верхнем регистре; уникальность частичным индексом
  ownerId        String?
  partnerId      String?
  description    String?
  percent        Int       @default(15) // утверждено заказчиком
  maxRedemptions Int? // null = без лимита
  usedCount      Int       @default(0)
  perUserLimit   Boolean   @default(false)
  minOrderAmount Int? // копейки
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  owner       User?                 @relation("PromoOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  partner     Partner?              @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  redemptions PromoCodeRedemption[]
  orders      Order[]
  offers      Offer[]

  @@index([ownerId])
  @@index([partnerId])
  @@index([isActive, expiresAt])
  @@map("promo_codes")
}

/// Факт применения кода.
///
/// orderId уникален — повторная отправка того же заказа не засчитается дважды.
/// Пара (promoCodeId, perUserKey) уникальна: при лимите «один раз на пациента»
/// в perUserKey пишется userId, и вторая параллельная попытка падает на
/// ограничении БД. Когда лимита нет, туда пишется NULL, а Postgres считает
/// NULL-ы различными — то же ограничение просто молчит.
model PromoCodeRedemption {
  id          String @id @default(uuid())
  promoCodeId String
  orderId     String @unique
  userId      String

  /// HMAC от userId с серверным секретом, а НЕ сам идентификатор: строка
  /// участвует в уникальном ограничении и не должна раскрывать пациента.
  perUserKey     String?
  discountAmount Int
  orderSubtotal  Int
  createdAt      DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([promoCodeId, orderId])
  @@unique([promoCodeId, perUserKey])
  @@index([promoCodeId, createdAt])
  @@index([userId])
  @@map("promo_code_redemptions")
}

// ─────────────────────────────── Бьюти-клуб ───────────────────────────────

/// Настройки Бьюти-клуба. Ровно одна строка (id = 1, CHECK в миграции).
/// Программа ВЫКЛЮЧЕНА по умолчанию: включает super_admin после ответов
/// клиента (docs/projects/perfect-skin/client/05-loyalty.md) и утверждения правил.
/// Деньги — копейки, бонусы — штуки, проценты — целые 0..100.
model LoyaltySettings {
  id                          Int                 @id @default(1)
  enabled                     Boolean             @default(false)
  accrualPercent              Int                 @default(5)
  accrualBase                 BonusAccrualBase    @default(paid_goods)
  accrualTrigger              BonusAccrualTrigger @default(delivered)
  accrualDelayDays            Int                 @default(0)
  excludeProfessionalProducts Boolean             @default(true)
  accrueWithPromo             Boolean             @default(false) // начислять ли по заказу с промокодом косметолога
  kopecksPerBonus             Int                 @default(100)   // курс: 100 = 1 бонус = 1 ₽
  maxSpendPercent             Int                 @default(30)    // доля товаров после промокода
  minOrderForSpend            Int                 @default(0)     // копейки, товары после промокода
  allowSpendWithPromo         Boolean             @default(false)
  bonusTtlDays                Int                 @default(365)   // срок жизни начислений; 0 = не сгорают
  refundMinTtlDays            Int                 @default(30)    // мин. срок жизни возвращённых при отмене
  welcomeBonus                Int                 @default(0)
  welcomeTtlDays              Int                 @default(60)
  reviewBonus                 Int                 @default(0)     // задел, не используется
  reviewTtlDays               Int                 @default(90)    // задел
  expiryNoticeKind            MessageKind         @default(advertising) // задел: писем о сгорании пока нет
  expiryNoticeDaysBefore      Int                 @default(7)            // задел
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  updatedById                 String?

  updatedBy User? @relation("LoyaltySettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("loyalty_settings")
}

/// Журнал изменений настроек: кто, когда, что было и что стало. Только вставка.
model LoyaltySettingsChange {
  id          String   @id @default(uuid())
  changedById String
  before      Json
  after       Json
  createdAt   DateTime @default(now())

  changedBy User @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([changedById])
  @@map("loyalty_settings_changes")
}

/// Бонусный счёт участника клуба. Создаётся при вступлении (принятии правил).
/// balance = сумма amount по журналу = сумма remaining у партий-начислений.
/// Меняется ТОЛЬКО в services/bonus.service.ts под блокировкой строки счёта.
/// При удалении пользователя userId обнуляется (SetNull), история остаётся обезличенной.
/// Мягкое удаление (users.deletedAt) обезличивает счёт ночная задача.
model BonusAccount {
  id           String    @id @default(uuid())
  userId       String?   @unique
  balance      Int       @default(0)
  joinedAt     DateTime  @default(now())
  leftAt       DateTime? // вышел из клуба: не копит и не тратит, остаток заморожен до правил программы
  anonymizedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactions BonusTransaction[]

  @@index([leftAt])
  @@map("bonus_accounts")
}

/// Журнал бонусного счёта. Строки не удаляются и не правятся, кроме remaining у партий.
/// amount со знаком: + начисление, − списание/сгорание/отмена начисления.
/// Партия = строка с amount > 0: remaining — непотраченный остаток, expiresAt — когда он сгорит (null = бессрочно).
/// У списаний remaining и expiresAt пустые (CHECK).
model BonusTransaction {
  id                 String      @id @default(uuid())
  accountId          String
  type               BonusTxType
  amount             Int
  remaining          Int?
  expiresAt          DateTime?
  orderId            String?
  idempotencyKey     String?     @unique // welcome:<userId> | manual:<uuid> | expire:<lotId>
  reason             String?     // обязательна у manual_adjustment (CHECK); покупателю не показывается
  createdById        String?     // автор ручной корректировки
  sourceMaxExpiresAt DateTime?   // у order_spend: самый поздний срок потраченных партий (null = среди них была бессрочная)
  createdAt          DateTime    @default(now())

  account   BonusAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy User?        @relation("BonusTxCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([orderId, type])
  @@index([accountId, createdAt])
  @@index([accountId, expiresAt])
  @@index([orderId])
  @@index([createdById])
  @@index([createdAt])
  @@map("bonus_transactions")
}

// ─────────────────────────────── Контент ───────────────────────────────

/// Публикация Бьюти-клуба. Кто её видит, решает audience —
/// отдельных «клубных» таблиц заводить не нужно.
model Post {
  id             String    @id @default(uuid())
  slug           String
  title          String
  excerpt        String?
  body           String
  coverImage     String?
  audience       Audience  @default(public)
  kind           PostKind  @default(article)
  /// Маркировка рекламы (РКН): слоты выключены по умолчанию, заполняет менеджер.
  isAd           Boolean   @default(false)
  advertiser     String? // «ИП Рыбко А. А., ИНН …»
  erid           String?
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([audience, publishedAt])
  @@index([kind, audience, publishedAt(sort: Desc)])
  @@index([slug])
  @@map("posts")
}

/// Видеоотзыв клиента. Публикуется только при полном наборе условий: согласие
/// с документом, проверка контента, готовые файлы и срок согласия не истёк.
/// Условие публикуемости — в services/video-review.service.ts и CHECK в БД.
model VideoReview {
  id                     String    @id @default(uuid())
  authorName             String // публичная подпись ровно как в согласии: «Анна, Москва»
  caption                String? // ≤140
  mp4Url                 String? // выставляет только загрузка
  webmUrl                String?
  posterUrl              String?
  productId              String?
  sortOrder              Int       @default(0)
  isActive               Boolean   @default(false)

  consentConfirmed       Boolean   @default(false)
  consentConfirmedAt     DateTime?
  consentConfirmedById   String?
  consentDocPath         String? // имя файла скана/PDF в приватном каталоге, выставляет только загрузка
  consentTemplateVersion String? // версия шаблона согласия, напр. «2026-10»
  consentAllowSite       Boolean   @default(false)
  consentAllowSocial     Boolean   @default(false)
  consentAllowAds        Boolean   @default(false)
  consentExpiresAt       DateTime? // null = бессрочно по согласию
  consentRevokedAt       DateTime?
  consentRevokedById     String?
  consentNote            String? // ≤300, где лежит оригинал

  /// Второй независимый статус: РКН-возражение по контенту ролика.
  contentReviewed        Boolean   @default(false)
  contentReviewedAt      DateTime?
  contentReviewedById    String?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  product            Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  consentConfirmedBy User?     @relation("VideoReviewConsentBy", fields: [consentConfirmedById], references: [id], onDelete: Restrict)
  consentRevokedBy   User?     @relation("VideoReviewConsentRevokedBy", fields: [consentRevokedById], references: [id], onDelete: Restrict)
  contentReviewedBy  User?     @relation("VideoReviewContentReviewedBy", fields: [contentReviewedById], references: [id], onDelete: Restrict)

  @@index([isActive, deletedAt, sortOrder])
  @@index([productId])
  @@index([consentConfirmedById])
  @@index([consentRevokedById])
  @@index([contentReviewedById])
  @@map("video_reviews")
}

/// Предложение. Без назначений — видно всей аудитории, с назначениями — только
/// перечисленным пользователям.
model Offer {
  id          String    @id @default(uuid())
  title       String
  description String?
  image       String?
  audience    Audience  @default(retail)
  promoCodeId String?
  linkUrl     String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  promoCode   PromoCode?        @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  assignments OfferAssignment[]

  @@index([audience, isActive, endsAt])
  @@index([promoCodeId])
  @@map("offers")
}

model OfferAssignment {
  offerId   String
  userId    String
  seenAt    DateTime?
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([offerId, userId])
  @@index([userId])
  @@map("offer_assignments")
}

model Banner {
  id          String         @id @default(uuid())
  title       String
  image       String
  imageMobile String?
  link        String?
  alt         String // обязателен: требование доступности
  page        BannerPage
  position    BannerPosition
  audience    Audience       @default(public)
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([page, position, isActive])
  @@map("banners")
}

/// Подбор косметики — плашка на главной. Может быть анонимным.
///
/// ВНИМАНИЕ: isPregnant и concerns — данные о здоровье, специальная категория
/// ПДн. sessionId читать ТОЛЬКО из подписанной httpOnly-cookie, никогда из
/// query или тела запроса, иначе чужая анкета открывается подбором строки.
model SkinSurvey {
  id               String    @id @default(uuid())
  userId           String?
  sessionId        String
  skinType         SkinType?
  concerns         Concern[]
  ageRange         String?
  isPregnant       Boolean? // противопоказания: ретинол, кислоты
  notes            String?
  resultProductIds String[]
  createdAt        DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("skin_surveys")
}

/// Заявка на консультацию косметолога — вторая плашка на главной.
model ConsultationRequest {
  id             String             @id @default(uuid())
  userId         String?
  name           String
  phone          String
  email          String?
  channel        String? // phone | telegram | whatsapp
  message        String?
  skinType       SkinType?
  concern        String?
  source         String? // tile | quiz | contacts
  status         ConsultationStatus @default(new)
  adminNote      String?
  consentVersion String?
  consentedAt    DateTime?
  anonymizedAt   DateTime? // когда персональные данные стёрты по сроку (3 месяца)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user     User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  consents ConsultationConsent[]

  @@index([status, createdAt])
  @@index([userId])
  @@map("consultation_requests")
}

// ──────────────────────── Синхронизация (1С и др.) ────────────────────────

/// Лог синхронизации с внешними системами (1С, склад, бухгалтерия).
/// Пока плейсхолдер под будущую волну.
model SyncLog {
  id         String   @id @default(uuid())
  direction  String // "import" | "export"
  status     String // "pending" | "success" | "failed"
  itemsCount Int      @default(0)
  errorText  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("sync_logs")
}

// ──────────────────────────── Согласия на ПДн ───────────────────────────

model ConsentRecord {
  id          String         @id @default(uuid())
  userId      String? // null после удаления пользователя: запись остаётся доказательством согласия
  purpose     ConsentPurpose
  textVersion String // версия текста согласия, который видел человек
  grantedAt   DateTime       @default(now())
  revokedAt   DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, purpose])
  @@map("consent_records")
}

/// Согласия отправителя консультации (в т.ч. гостя без аккаунта).
/// Переживают удаление заявки (SetNull) как доказательство согласия.
model ConsultationConsent {
  id             String         @id @default(uuid())
  consultationId String?
  purpose        ConsentPurpose
  textVersion    String
  ip             String?
  form           String? // из какой формы: consultation | care — после чистки заявки видно происхождение
  grantedAt      DateTime       @default(now())
  revokedAt      DateTime? // когда клиент отозвал согласие (реклама)

  consultation ConsultationRequest? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([consultationId])
  @@map("consultation_consents")
}

// ──────────────────── Реестр МСП (справочник из ФНС) ────────────────────

enum RegistryKind {
  legal // юрлицо (1 → ОргВклМСП, ИННЮЛ 10 цифр)
  individual // ИП (2 → ИПВклМСП, ИННФЛ 12 цифр)
}

/// Профильный бизнес из открытого реестра МСП ФНС.
/// Отбираются по кодам ОКВЭД: если ANY код из СвОКВЭД совпадает с префиксом
/// или начинается с префикса + '.', запись профильная.
model RegistryProfile {
  inn         String       @id // ИННЮЛ (10) или ИННФЛ (12)
  ogrn        String       @unique // ОГРН (13) или ОГРНИП (15)
  kind        RegistryKind
  name        String // НаимОргСокр или «ИП Фамилия И. О.»
  okvedMain   String? // основной ОКВЭД из СвОКВЭДОсн, версия 2014
  okveds      String[] // все коды из СвОКВЭД (основной + доп.), версия 2014, без дублей
  releaseDate DateTime // ДатаСост выпуска архива
  createdAt   DateTime     @default(now())

  @@index([ogrn])
  @@index([releaseDate])
  @@map("registry_profiles")
}

/// Запись о выпуске и импорте реестра: для отслеживания версий.
model RegistryRelease {
  id          String   @id @default(uuid())
  sourceUrl   String
  releaseDate DateTime // ДатаСост из XML
  scanned     Int // сколько Документов прочитано
  matched     Int // сколько профильных записали в БД
  importedAt  DateTime @default(now())

  @@index([releaseDate])
  @@map("registry_releases")
}

// ──────────────────────── Документы для проверки ПРО ────────────────────────

/// Загруженный документ (фото сертификата или диплома косметолога).
/// После решения (одобрение/отклонение) файл удаляется:
/// - при автоодобрении сразу же (deleteAfter = now, deletedAt = now);
/// - при ручном решении через 30 дней (deleteAfter = now + 30 дней).
/// В БД остаётся запись о документе без файла: тип, размер, sha256, когда загружен, когда удалён.
model ProDocument {
  id          String    @id @default(uuid())
  userId      String
  storageKey  String? // имя файла (uuid) в PS_PRO_DOCS_DIR; null после удаления файла
  mime        String // image/jpeg | image/png | application/pdf — по сигнатуре байтов
  sizeBytes   Int
  sha256      String
  uploadedAt  DateTime  @default(now())
  deleteAfter DateTime? // когда удалить файл; null пока решения нет
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deleteAfter])
  @@index([userId])
  @@map("pro_documents")
}

// ВАЖНО: Уникальность ИНН среди одобренных — на уровне БД в SQL миграции.
// Prisma не выражает условные уникальные индексы, поэтому индекс создан в миграции:
// CREATE UNIQUE INDEX "users_inn_approved_key" ON "users"("inn")
//   WHERE "proStatus" = 'approved' AND "deletedAt" IS NULL;

// ─────────────────────────────── Telegram ───────────────────────────────

/// Тип Telegram-бота.
enum TelegramBotKind {
  pro    // Бот заявок: специалисты, консультации
  orders // Бот заказов: уведомления о новых заказах
}

/// Привязка сотрудника к его приватному чату с ботом.
/// Composite PK (userId, botKind) — один человек может привязать оба бота одновременно.
model TelegramLink {
  userId   String              // сотрудник (User с ролью из STAFF)
  botKind  TelegramBotKind     @default(pro)
  chatId   BigInt              // приватный чат с ботом = Telegram user id
  linkedAt DateTime            @default(now())
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, botKind])
  @@unique([chatId, botKind])
  @@map("telegram_links")
}

/// Одноразовый код привязки из админки (живёт 10 минут).
/// Уникальность по (codeHash) — один код на одну операцию.
model TelegramLinkCode {
  codeHash  String              @id // sha256 кода
  userId    String
  botKind   TelegramBotKind     @default(pro)
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@map("telegram_link_codes")
}

/// Одноразовая ссылка на просмотр заявки (живёт 10 минут, до 5 обращений).
model DocViewToken {
  tokenHash   String   @id // sha256 токена
  applicantId String
  staffUserId String
  expiresAt   DateTime
  uses        Int      @default(0)

  @@index([expiresAt])
  @@map("doc_view_tokens")
}

/// Какие сообщения отправлены в Telegram по заявке (для редактирования при решении).
model TelegramNotice {
  id          String   @id @default(uuid())
  applicantId String
  chatId      BigInt
  messageId   Int
  sentAt      DateTime @default(now())

  @@index([applicantId])
  @@map("telegram_notices")
}
