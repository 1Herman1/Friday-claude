# Шаблон боевого server/.env для VPS Perfect Skin.
# Скопировать в server/.env и заполнить реальными значениями.
# НЕ коммитить в репозиторий.

# ============================================================================
# ОБЯЗАТЕЛЬНЫЕ ДЛЯ СТАРТА (сервер не поднимется без них — см. index.ts)
# ============================================================================

# PostgreSQL (Postgres в Docker, пароль — НЕ дефолтный)
PS_DATABASE_URL="postgresql://ps:PASSWORD@localhost:5432/perfect_skin"

# Хеширование куки аутентификации. Сгенерировать: openssl rand -hex 32
PS_COOKIE_SECRET="ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_HEX_32"

# JWT для токенов доступа. Сгенерировать: openssl rand -hex 32
JWT_SECRET="ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_HEX_32"

# HMAC-ключ для подписи промокодов (особенно 15% скидки косметолога).
# Сгенерировать: openssl rand -hex 32
PS_PROMO_HMAC_SECRET="ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_HEX_32"

# CORS: откуда фронт запрашивает API (кука ps_auth имеет sameSite: lax,
# поэтому домен ДОЛЖЕН совпадать). При переезде на боевой домен поменять.
PS_CORS_ORIGIN="https://new.perfect-skin.shop"

# ============================================================================
# СРЕДА И ПОРТ
# ============================================================================

NODE_ENV="production"
PORT="3000"
HOST="127.0.0.1"

# ============================================================================
# EMAIL (OTP, уведомления)
# Без SMTP вход и восстановление пароля не работают.
# ============================================================================

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@perfect-skin.shop"
SMTP_PASS="ПАРОЛЬ_ПОЧТЫ"
SMTP_FROM="noreply@perfect-skin.shop"
# SMTP_SECURE: true для 465, false для 587 с STARTTLS
SMTP_SECURE="false"

# ============================================================================
# SMS (OTP, опционально — альтернатива email)
# ============================================================================

SMS_PROVIDER="smsc"  # или "twilio", или другой провайдер
SMS_API_KEY=""
SMS_SENDER="PERFECT"

# ============================================================================
# 1С (интеграция прайса и остатков, опционально)
# ============================================================================

PS_1C_LOGIN=""
PS_1C_PASSWORD=""

# ============================================================================
# JWT: параметры токенов
# ============================================================================

JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
