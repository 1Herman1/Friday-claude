# Database
DATABASE_URL="postgresql://simba:simba_dev@localhost:5432/simba"

# JWT
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="7d"

# Перец для кодов подтверждения (OTP): HMAC-ключ, которым солятся коды в базе.
# Без него дамп таблицы otp_codes перебирается за секунды — кодов всего 900 000.
# Если пусто, сервер берёт JWT_SECRET, но отдельный секрет надёжнее: тогда
# утечка одного не раскрывает другое. Значение задаётся в окружении сервера,
# в репозитории секретов не держим.
OTP_PEPPER=

# Minio
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="simba"
MINIO_SECRET_KEY="simba_dev"
MINIO_BUCKET="simba-products"

# SMS (для OTP)
SMS_API_KEY=""
SMS_SENDER=""

# Email (для OTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@simbazoo.ru"

# Frontend URL
CLIENT_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# Склад, откуда уезжают заказы. От этих координат считают цену все службы;
# раньше здесь был зашит центр Москвы, и цены выходили «от Кремля».
WAREHOUSE_ADDRESS="Москва, ул. Ленина, 12"
WAREHOUSE_LAT="55.755864"
WAREHOUSE_LON="37.617617"

# Подсказки адреса на оформлении заказа — DaData (https://dadata.ru → API-ключи).
# До 10 000 подсказок в сутки бесплатно. Ключ только на сервере: витрина ходит
# через наш /api/address/suggest. Без ключа поля адреса остаются обычными.
DADATA_TOKEN=""

# Доставка — СДЭК
CDEK_CLIENT_ID=""
CDEK_CLIENT_SECRET=""
CDEK_SANDBOX="true"
# Код города склада в справочнике СДЭК (Москва = 44). От него считаются тарифы.
CDEK_SENDER_CITY_CODE="44"

# Доставка — Яндекс
YANDEX_DELIVERY_TOKEN=""
# Пункты выдачи Яндекса считаются от склада: это platform_station_id склада
# из кабинета Яндекс.Доставки (раздел «Склады»). Без него ПВЗ Яндекса не
# предлагаются — цена до пункта считается именно от станции отправления.
YANDEX_PVZ_SOURCE_STATION=""


# Доставка — Достависта
DOSTAVISTA_TOKEN=""

# Доставка — Почта России
POST_RU_TOKEN=""
POST_RU_USER_KEY=""

# Доставка — Ozon Seller
OZON_CLIENT_ID=""
OZON_API_KEY=""
