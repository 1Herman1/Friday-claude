{
  "name": "friday",
  "private": true,
  "workspaces": [
    "projects/simba/shared",
    "projects/simba/server",
    "projects/simba/client",
    "projects/simba/admin",
    "projects/perfect-skin/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@simba/shared",
    "dev:server": "npm run dev --workspace=@simba/server",
    "dev:client": "npm run dev --workspace=@simba/client",
    "dev:admin": "npm run dev --workspace=@simba/admin",
    "test": "npm run test --workspace=@simba/server && npm run test --workspace=@simba/client",
    "test:perfect-skin": "npm run test --workspace=@ps/shared"
  },
  "devDependencies": {
    "@iconify-json/iconoir": "^1.2.11",
    "playwright-core": "^1.62.1"
  }
}
