{
  "mcpServers": {
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${TWENTYFIRST_API_KEY}"
      }
    },
    "icon-library": {
      "command": "npx",
      "args": ["tsx", "tools/icon-mcp-server/src/index.ts"],
      "env": {
        "LOTTIEFILES_API_KEY": "${LOTTIEFILES_API_KEY}"
      }
    },
    "nullume": {
      "command": "bash",
      "args": ["tools/nullume/bin/mcp-stdio.sh"],
      "env": {
        "KIE_API_KEY": "${KIE_API_KEY}"
      }
    }
  }
}
