{
  "name": "nullume",
  "version": "0.1.0",
  "private": true,
  "description": "CLI + MCP for media generation via kie.ai",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "nullume": "bin/nullume.js"
  },
  "scripts": {
    "start": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "build": "tsc -p tsconfig.build.json",
    "build:catalog": "tsx scripts/build-catalog.mts",
    "audit:catalog": "tsx scripts/audit-catalog.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30",
    "commander": "^15",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.9"
  }
}
